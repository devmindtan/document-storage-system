            type="text"
            name="location"
            maxlength="50"
            required
            aria-required="true"
            placeholder="Nhập vị trí hồ sơ, tối đa 50 ký tự"
            value="{{ location_value }}"
            oninvalid="this.setCustomValidity('Vui lòng nhập vị trí hồ sơ.')"
            oninput="this.setCustomValidity('')"
        >

        <p class="note-text">
            Bắt buộc nhập. Tối đa 50 ký tự.
        </p>

        <button type="submit" class="primary-upload-button">
      Gửi hồ sơ cho quản lý duyệt
</button>
    </form>

    <p class="note-text">
        Nếu cần project mới hoặc file con mới, hãy chọn trực tiếp trong danh sách phía trên. Quản lý chỉ cần duyệt hồ sơ một lần.
