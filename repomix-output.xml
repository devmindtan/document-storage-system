    function getLanguage() {
        return localStorage.getItem("appLanguage") || "vi";
    }

    function setLanguage(language) {
        localStorage.setItem("appLanguage", language);
    }

    function setText(selector, value) {
        const element = document.querySelector(selector);
        if (element) {
            element.textContent = value;
        }
    }

    function setPlaceholder(selector, value) {
        const element = document.querySelector(selector);
        if (element) {
            element.setAttribute("placeholder", value);
        }
    }

    function setHeaderPersonLabel(value) {
        const paragraph = document.querySelector(".top-bar p");
        if (!paragraph) {
            return;
        }

        const strong = paragraph.querySelector("strong");
        const name = strong ? strong.textContent : "";

        paragraph.innerHTML = "";
        paragraph.appendChild(document.createTextNode(value + " "));

        const newStrong = document.createElement("strong");
        newStrong.textContent = name;
        paragraph.appendChild(newStrong);
    }

    function setLabelWithRequiredStar(selector, value) {
        const label = document.querySelector(selector);
        if (!label) {
            return;
        }

        label.innerHTML = "";
        label.appendChild(document.createTextNode(value + " "));

        const star = document.createElement("span");
        star.className = "required-star";
        star.textContent = "*";
        label.appendChild(star);
    }

    function setPlainLabel(selector, value) {
        const label = document.querySelector(selector);
        if (label) {
            label.textContent = value;
        }
    }

    function updateNoFileText(value) {
        const element = document.getElementById("selectedFileText");
        if (!element) {
            return;
        }

        const currentText = element.textContent.replace(/\s+/g, " ").trim();
        const defaultTexts = [
            "Không có tệp nào được chọn",
            "No files selected"
        ];

        if (defaultTexts.includes(currentText)) {
            element.textContent = value;
        }
    }

    function applyUploadPageLanguage(language) {
        const text = PAGE_TEXT[language];
        const button = document.getElementById("languageToggle");

        document.documentElement.lang = language;

        if (button) {
            button.textContent = language === "vi" ? "EN" : "VI";
        }

        setText("h1", text.title);
        setHeaderPersonLabel(text.personLabel);
        setText(".logout-button", text.back);

        setPlainLabel("label[for='project_key']", text.projectLabel);
        setPlainLabel("label[for='category_key']", text.documentTypeLabel);
        setText("#project_key option[value='__new_project__']", text.newProjectOption);

        setLabelWithRequiredStar("label[for='new_project_name']", text.newProjectNameLabel);
        setPlaceholder("#new_project_name", text.newProjectPlaceholder);
        setText("#newProjectBox .note-text", text.newProjectNote);

        setLabelWithRequiredStar("label[for='new_category_name']", text.newCategoryNameLabel);
        setPlainLabel("label[for='new_category_code']", text.newCategoryCodeLabel);
        setPlaceholder("#new_category_name", text.newCategoryNamePlaceholder);
        setPlaceholder("#new_category_code", text.newCategoryCodePlaceholder);
        setText("#newCategoryBox .note-text", text.newCategoryNote);

        const fileUploadBox = document.querySelector(".custom-file-upload");
        if (fileUploadBox && fileUploadBox.previousElementSibling) {
            fileUploadBox.previousElementSibling.textContent = text.fileSelectionLabel;
        }

        setText(".custom-file-button", text.chooseFileButton);
        updateNoFileText(text.noFilesSelected);

        setLabelWithRequiredStar("label[for='description']", text.descriptionLabel);
        setPlaceholder("#description", text.descriptionPlaceholder);

        setLabelWithRequiredStar("label[for='location']", text.locationLabel);
        setPlaceholder("#location", text.locationPlaceholder);

        const requiredNotes = document.querySelectorAll("form > p.note-text");
        if (requiredNotes[0]) {
            requiredNotes[0].textContent = text.requiredNote;
        }
        if (requiredNotes[1]) {
            requiredNotes[1].textContent = text.requiredNote;
        }

        const submitButton = document.querySelector("form button[type='submit']");
        if (submitButton) {
            submitButton.textContent = text.submitButton;
        }

        const bottomNote = document.querySelector(".dashboard-box > p.note-text");
        if (bottomNote) {
            bottomNote.textContent = text.bottomNote;
        }

        setText("#deleteProjectTitle", text.deleteProjectTitle);
        setText("#deleteProjectNote", text.deleteProjectNote);
        setPlainLabel("label[for='delete_project_id']", text.selectProjectToDelete);
        const deleteProjectSelect = document.getElementById("delete_project_id");
        if (deleteProjectSelect && deleteProjectSelect.options.length > 0) {
            deleteProjectSelect.options[0].textContent = text.selectProjectToDelete;
        }
        setText("#deleteProjectButton", text.deleteProjectButton);

        setText("#existingCategoryTitle", text.existingCategoryTitle);
        setText("#existingCategoryNote", text.existingCategoryNote);
        setPlainLabel("label[for='delete_category_id']", text.selectCategoryToDelete);
        setText("#deleteCategoryButton", text.deleteCategoryButton);

        const deleteCategorySelect = document.getElementById("delete_category_id");
        if (deleteCategorySelect && deleteCategorySelect.options.length > 0 && !deleteCategorySelect.value) {
            deleteCategorySelect.options[0].textContent = text.selectCategoryToDelete;
        }

        if (typeof window.renderCategoryManagementList === "function") {
            window.renderCategoryManagementList(
                window.currentCategoryManagementData || [],
                window.currentCategoryManagementProjectId || ""
            );
        }

        setLanguage(language);
    }

    document.addEventListener("DOMContentLoaded", function () {
        applyUploadPageLanguage(getLanguage());

        const button = document.getElementById("languageToggle");
        if (button) {
            button.addEventListener("click", function () {
                const currentLanguage = getLanguage();
                const nextLanguage = currentLanguage === "vi" ? "en" : "vi";
                applyUploadPageLanguage(nextLanguage);
            });
        }
    });

    window.applyUploadPageLanguage = applyUploadPageLanguage;
})();
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
    const NEW_PROJECT_KEY = "__new_project__";
    const NEW_CATEGORY_KEY = "__new_category__";
    const DEFAULT_CATEGORY_PREFIX = "__default_category__:";

    const defaultCategories = [
        { id: DEFAULT_CATEGORY_PREFIX + "BC", label: "Business Case" },
        { id: DEFAULT_CATEGORY_PREFIX + "CAPEX", label: "CAPEX" },
        { id: DEFAULT_CATEGORY_PREFIX + "PTW", label: "PTW" },
        { id: DEFAULT_CATEGORY_PREFIX + "JSA", label: "JSA" },
        { id: DEFAULT_CATEGORY_PREFIX + "RAHS", label: "Risk Assessment / Hazard Study" },
        { id: DEFAULT_CATEGORY_PREFIX + "DWG", label: "Drawings" },
        { id: DEFAULT_CATEGORY_PREFIX + "FSH", label: "FAT / SAT / Handover" },
        { id: DEFAULT_CATEGORY_PREFIX + "PHOTO", label: "Photos" },
        { id: DEFAULT_CATEGORY_PREFIX + "TSOP", label: "Training / SOP" },
        { id: DEFAULT_CATEGORY_PREFIX + "LEG", label: "Legal" },
        { id: DEFAULT_CATEGORY_PREFIX + "VM", label: "Vendor Manual" },
        { id: DEFAULT_CATEGORY_PREFIX + "OTH", label: "Others" }
    ];

    const projectSelect = document.getElementById("project_key");
    const categorySelect = document.getElementById("category_key");
    const newProjectBox = document.getElementById("newProjectBox");
    const newProjectInput = document.getElementById("new_project_name");
    const newCategoryBox = document.getElementById("newCategoryBox");
    const newCategoryNameInput = document.getElementById("new_category_name");
    const fileInput = document.getElementById("uploaded_files");
    const selectedFileText = document.getElementById("selectedFileText");


    function renderCategoryManagementList(categories, projectId) {
        const deleteCategoryForm = document.getElementById("deleteCategoryForm");
        const deleteCategorySelect = document.getElementById("delete_category_id");
        const hiddenProjectInput = document.getElementById("delete_category_project_key");
        const deleteCategoryButton = document.getElementById("deleteCategoryButton");
        const languageSource = window.MANAGER_UPLOAD_PAGE_TEXT || {};
        const languageText = languageSource[currentLanguage()] || languageSource.vi || {};

        window.currentCategoryManagementData = categories || [];
        window.currentCategoryManagementProjectId = projectId || "";

        if (!deleteCategorySelect) {
            return;
        }

        deleteCategorySelect.innerHTML = "";

        function addDeleteCategoryOption(value, label) {
            const option = document.createElement("option");
            option.value = value;
            option.textContent = label;
            deleteCategorySelect.appendChild(option);
        }

        function disableDeleteCategoryForm(message) {
            addDeleteCategoryOption("", message);
            deleteCategorySelect.disabled = true;

            if (deleteCategoryButton) {
                deleteCategoryButton.disabled = true;
            }

            if (hiddenProjectInput) {
                hiddenProjectInput.value = "";
            }
        }

        if (!projectId) {
            disableDeleteCategoryForm(languageText.selectProjectForCategories);
            return;
        }

        if (projectId === NEW_PROJECT_KEY) {
            disableDeleteCategoryForm(languageText.selectExistingProjectForCategories);
            return;
        }

        if (!categories || categories.length === 0) {
            disableDeleteCategoryForm(languageText.noCategoriesInProject);
            return;
        }

        addDeleteCategoryOption("", languageText.selectCategoryToDelete);

        categories.forEach(function (category) {
            let label = category.label;

            if (category.code) {
                label = label + " - " + languageText.categoryCodePrefix + " " + category.code;
            }

            addDeleteCategoryOption(category.id, label);
        });

        deleteCategorySelect.disabled = false;

        if (deleteCategoryButton) {
            deleteCategoryButton.disabled = false;
            deleteCategoryButton.textContent = languageText.deleteCategoryButton;
        }

        if (hiddenProjectInput) {
            hiddenProjectInput.value = projectId;
        }

        if (deleteCategoryForm) {
            deleteCategoryForm.onsubmit = function () {
                const categoryId = deleteCategorySelect.value;

                if (!categoryId) {
                    return false;
                }

                deleteCategoryForm.action = "/manager/project-categories/" + categoryId + "/delete";

                return confirm(getDeleteCategoryConfirmText());
            };
        }
    }

    window.renderCategoryManagementList = renderCategoryManagementList;

    function currentLanguage() {
        return localStorage.getItem("appLanguage") || "vi";
    }

    function text(vi, en) {
        return currentLanguage() === "en" ? en : vi;
    }

    function setRequired(input, required) {
        if (!input) {
            return;
        }

        if (required) {
            input.setAttribute("required", "required");
        } else {
            input.removeAttribute("required");
        }
    }

    function addOption(value, label, selectedValue) {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = label;

        if (String(value) === String(selectedValue)) {
            option.selected = true;
        }

        categorySelect.appendChild(option);
    }

    function updateNewProjectBox() {
        const isNewProject = projectSelect.value === NEW_PROJECT_KEY;

        newProjectBox.classList.toggle("is-visible", isNewProject);
        setRequired(newProjectInput, isNewProject);
    }

    function updateNewCategoryBox() {
        const isNewCategory = categorySelect.value === NEW_CATEGORY_KEY;

        newCategoryBox.classList.toggle("is-visible", isNewCategory);
        setRequired(newCategoryNameInput, isNewCategory);
    }

    function addCreateNewCategoryOption(selectedCategoryKey) {
        addOption(
            NEW_CATEGORY_KEY,
            text("+ Tạo file con mới", "+ Create new document type"),
            selectedCategoryKey
        );
    }

    function loadDefaultCategoriesForNewProject(selectedCategoryKey) {
        categorySelect.innerHTML = "";

        defaultCategories.forEach(function (category) {
            addOption(category.id, category.label, selectedCategoryKey);
        });

        addCreateNewCategoryOption(selectedCategoryKey);

        categorySelect.disabled = false;

        if (!categorySelect.value && categorySelect.options.length > 0) {
            categorySelect.selectedIndex = 0;
        }

        categorySelect.dataset.selectedCategoryKey = categorySelect.value;
        updateNewCategoryBox();
        renderCategoryManagementList([], NEW_PROJECT_KEY);
    }

    function updateCategoryDropdown() {
        const projectId = projectSelect.value;
        const selectedCategoryKey = categorySelect.dataset.selectedCategoryKey || "";

        updateNewProjectBox();

        if (projectId === NEW_PROJECT_KEY) {
            loadDefaultCategoriesForNewProject(selectedCategoryKey);
            return;
        }

        categorySelect.innerHTML = "";

        if (!projectId) {
            addOption("", text("Không có file con", "No document types"), "");
            categorySelect.disabled = true;
            updateNewCategoryBox();
            renderCategoryManagementList([], "");
            return;
        }

        addOption("", text("Đang tải file con...", "Loading document types..."), "");

        fetch("/project-categories/" + projectId, {
            method: "GET",
            headers: {
                "Accept": "application/json"
            }
        })
        .then(function (response) {
            return response.json();
        })
        .then(function (data) {
            categorySelect.innerHTML = "";

            if (!data.success || !data.categories || data.categories.length === 0) {
                addOption("", text("Không có file con", "No document types"), "");
                addCreateNewCategoryOption(selectedCategoryKey);
                categorySelect.disabled = false;
                updateNewCategoryBox();
                renderCategoryManagementList([], projectId);
                return;
            }

            data.categories.forEach(function (category) {
                addOption(category.id, category.label, selectedCategoryKey);
            });

            renderCategoryManagementList(data.categories, projectId);

            addCreateNewCategoryOption(selectedCategoryKey);

            categorySelect.disabled = false;

            if (!categorySelect.value && categorySelect.options.length > 0) {
                categorySelect.selectedIndex = 0;
            }

            categorySelect.dataset.selectedCategoryKey = categorySelect.value;
            updateNewCategoryBox();
        })
        .catch(function () {
            categorySelect.innerHTML = "";
            addOption("", text("Không thể tải file con", "Cannot load document types"), "");
            categorySelect.disabled = true;
            updateNewCategoryBox();
            renderCategoryManagementList([], projectId);
        });
    }

    if (fileInput && selectedFileText) {
        fileInput.addEventListener("change", function () {
            const files = Array.from(fileInput.files);

            if (files.length === 0) {
                selectedFileText.textContent = text("Không có tệp nào được chọn", "No files selected");
                return;
            }

            if (files.length === 1) {
                selectedFileText.textContent = files[0].name;
                return;
            }

            selectedFileText.textContent = text("Đã chọn ", "Selected ") + files.length + text(" tệp", " files");
        });
    }

    if (projectSelect && categorySelect) {
        projectSelect.addEventListener("change", function () {
            categorySelect.dataset.selectedCategoryKey = "";
            updateCategoryDropdown();
        });

        categorySelect.addEventListener("change", function () {
            categorySelect.dataset.selectedCategoryKey = categorySelect.value;
            updateNewCategoryBox();
        });

        updateCategoryDropdown();
    }

    const languageButton = document.getElementById("languageToggle");

    if (languageButton) {
        languageButton.addEventListener("click", function () {
            setTimeout(function () {
                if (projectSelect && categorySelect) {
                    const currentCategoryValue = categorySelect.value;
                    categorySelect.dataset.selectedCategoryKey = currentCategoryValue;
                    updateCategoryDropdown();
                }
            }, 120);
        });
    }
});
</script>

</body>
</html>
</file>

<file path="templates/manager_users.html">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
