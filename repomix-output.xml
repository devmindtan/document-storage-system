<script>
    (function () {
        const REGISTER_TEXT = {
            vi: {
                pageTitle: "Đăng ký tài khoản", registerTitle: "ĐĂNG KÝ TÀI KHOẢN",
                registerSubtitle: "Tạo tài khoản nhân viên để sử dụng hệ thống.", usernameLabel: "Username",
                usernamePlaceholder: "Nhập username", fullNameLabel: "Họ và tên",
                fullNamePlaceholder: "Nhập họ và tên", passwordLabel: "Mật khẩu",
                passwordPlaceholder: "Ít nhất 8 ký tự", confirmPasswordLabel: "Nhập lại mật khẩu",
                confirmPasswordPlaceholder: "Nhập lại mật khẩu", registerButton: "Đăng ký",
                haveAccountText: "Đã có tài khoản?", backToLogin: "Quay lại đăng nhập"
            },
            en: {
                pageTitle: "Register account", registerTitle: "CREATE AN ACCOUNT",
                registerSubtitle: "Create a staff account to use the system.", usernameLabel: "Username",
                usernamePlaceholder: "Enter username", fullNameLabel: "Full name",
                fullNamePlaceholder: "Enter full name", passwordLabel: "Password",
                passwordPlaceholder: "At least 8 characters", confirmPasswordLabel: "Confirm password",
                confirmPasswordPlaceholder: "Re-enter password", registerButton: "Register",
                haveAccountText: "Already have an account?", backToLogin: "Back to login"
            }
        };

        function getRegisterLanguage() {
            const savedLanguage = localStorage.getItem("appLanguage");
            return (savedLanguage === "en" || savedLanguage === "vi") ? savedLanguage : "vi";
        }
        function saveRegisterLanguage(language) { localStorage.setItem("appLanguage", language); }
        function setTextById(id, value) { const el = document.getElementById(id); if (el) el.textContent = value; }
        function setPlaceholderById(id, value) { const el = document.getElementById(id); if (el) el.setAttribute("placeholder", value); }

        function applyRegisterLanguage(language) {
            const text = REGISTER_TEXT[language];
            const languageButton = document.getElementById("languageToggle");
            document.documentElement.lang = language;
            document.title = text.pageTitle;
            if (languageButton) languageButton.textContent = language === "vi" ? "EN" : "VI";
            setTextById("registerTitle", text.registerTitle);
            setTextById("registerSubtitle", text.registerSubtitle);
            setTextById("usernameLabel", text.usernameLabel);
            setPlaceholderById("username", text.usernamePlaceholder);
            setTextById("fullNameLabel", text.fullNameLabel);
            setPlaceholderById("full_name", text.fullNamePlaceholder);
            setTextById("passwordLabel", text.passwordLabel);
            setPlaceholderById("password", text.passwordPlaceholder);
            setTextById("confirmPasswordLabel", text.confirmPasswordLabel);
            setPlaceholderById("confirm_password", text.confirmPasswordPlaceholder);
            setTextById("registerButton", text.registerButton);
            setTextById("haveAccountText", text.haveAccountText);
            setTextById("backToLogin", text.backToLogin);
            saveRegisterLanguage(language);
        }

        document.addEventListener("DOMContentLoaded", function () {
            applyRegisterLanguage(getRegisterLanguage());
            const languageButton = document.getElementById("languageToggle");
            if (languageButton) {
                languageButton.onclick = function () {
                    applyRegisterLanguage(getRegisterLanguage() === "vi" ? "en" : "vi");
                };
            }
        });

        window.applyRegisterLanguage = applyRegisterLanguage;
    })();
</script>
{% endblock %}
