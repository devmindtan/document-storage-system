<script>
    // --- LOGIC CHO MODAL ---
    function openDocumentModal(btn) {
        const modal = document.getElementById('documentDetailsModal');
        const box = modal.querySelector('div');

        document.getElementById('modal_doc_code').textContent = btn.dataset.code || '-';
        document.getElementById('modal_original_name').textContent = btn.dataset.name || '-';
        document.getElementById('modal_category').textContent = btn.dataset.category || '-';
        document.getElementById('modal_submitted_at').textContent = btn.dataset.date || '-';
        document.getElementById('modal_reviewed_by').textContent = btn.dataset.reviewer || '-';

        // Render Badge Trạng Thái
        const status = btn.dataset.status;
        const badgeContainer = document.getElementById('modal_status_badge');
        const rejectionContainer = document.getElementById('modal_rejection_container');

        if (status === 'PENDING') {
            badgeContainer.innerHTML = '<span class="bg-amber-100 text-amber-700 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="statusPending">Chờ duyệt</span>';
            rejectionContainer.classList.add('hidden');
        } else if (status === 'APPROVED') {
            badgeContainer.innerHTML = '<span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="statusApproved">Đã duyệt</span>';
            rejectionContainer.classList.add('hidden');
        } else if (status === 'REJECTED') {
            badgeContainer.innerHTML = '<span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="statusRejected">Bị từ chối</span>';
            document.getElementById('modal_rejection_reason').textContent = btn.dataset.reason || '-';
            rejectionContainer.classList.remove('hidden');
        } else {
            badgeContainer.innerHTML = '<span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="statusUnknown">Không rõ</span>';
            rejectionContainer.classList.add('hidden');
        }

        // Trigger lại dịch ngôn ngữ cho các thành phần vừa tiêm vào DOM
        if (typeof window.setPageLanguage === 'function') {
            window.setPageLanguage(window.getCurrentLanguageSafe());
        }

        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            box.classList.remove('scale-95');
        }, 10);
    }

    function closeDocumentModal() {
        const modal = document.getElementById('documentDetailsModal');
        const box = modal.querySelector('div');

        modal.classList.add('opacity-0');
        box.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }
</script>

<script>
    // --- LOGIC ĐA NGÔN NGỮ ---
    (function () {
        const PAGE_TRANSLATIONS = {
            vi: {
                myDocumentsTitle: "HỒ SƠ CỦA TÔI",
                employeeLabel: "Nhân viên:",
                noEmployeeDocuments: "Bạn chưa gửi hồ sơ nào.",
                tableId: "ID",
                action: "Thao tác",
                fileName: "Tên file",
                type: "Loại",
                submittedAt: "Ngày gửi",
                status: "Trạng thái",
                approvedBy: "Người duyệt",
                statusPending: "Chờ duyệt",
                statusApproved: "Đã duyệt",
                statusRejected: "Bị từ chối",
                statusUnknown: "Không rõ",
                rejectionReason: "Lý do từ chối",
                detailBtn: "Chi tiết",
                modalTitle: "Chi tiết hồ sơ",
                closeBtn: "Đóng"
            },
            en: {
                myDocumentsTitle: "MY DOCUMENTS",
                employeeLabel: "Employee:",
                noEmployeeDocuments: "You have not submitted any documents yet.",
                tableId: "ID",
                action: "Action",
                fileName: "File name",
                type: "Type",
                submittedAt: "Submitted at",
                status: "Status",
                approvedBy: "Reviewed by",
                statusPending: "Pending",
                statusApproved: "Approved",
                statusRejected: "Rejected",
                statusUnknown: "Unknown",
                rejectionReason: "Rejection reason",
                detailBtn: "Details",
                modalTitle: "Document Details",
                closeBtn: "Close"
            }
        };

        function getCurrentLanguageSafe() {
            const savedLanguage = localStorage.getItem("appLanguage");
            return (savedLanguage === "en" || savedLanguage === "vi") ? savedLanguage : "vi";
        }

        function setPageLanguage(language) {
            const languageButton = document.getElementById("languageToggle");
            if (languageButton) {
                (languageButton.querySelector("span") || languageButton).textContent = language === "vi" ? "EN" : "VI";
            }
            document.documentElement.lang = language;
            const translations = PAGE_TRANSLATIONS[language] || PAGE_TRANSLATIONS.vi;

            document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-key");
                if (translations[key]) {
                    element.textContent = translations[key];
                }
            });

            document.querySelectorAll("[data-i18n-placeholder-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-placeholder-key");
                if (translations[key]) {
                    element.setAttribute("placeholder", translations[key]);
                }
            });

            const pageTitleKey = document.body.getAttribute("data-page-title-key");
            if (pageTitleKey && translations[pageTitleKey]) {
                document.title = translations[pageTitleKey];
            }
            localStorage.setItem("appLanguage", language);
        }

        // Expose ra window để trigger lại sau khi open Modal JS
        window.getCurrentLanguageSafe = getCurrentLanguageSafe;
        window.setPageLanguage = setPageLanguage;

        function patchGlobalApplyLanguage() {
            if (typeof window.applyLanguage === "function" && !window.applyLanguage.__pageTranslationPatched) {
                const originalApplyLanguage = window.applyLanguage;
                window.applyLanguage = function (language) {
                    try { originalApplyLanguage(language); } catch (error) { console.warn(error); }
                    setPageLanguage(language);
                };
                window.applyLanguage.__pageTranslationPatched = true;
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            patchGlobalApplyLanguage();
            setPageLanguage(getCurrentLanguageSafe());

            const languageButton = document.getElementById("languageToggle");
            if (languageButton && !languageButton.dataset.pageTranslationBound) {
                languageButton.dataset.pageTranslationBound = "1";
                languageButton.addEventListener("click", function () {
                    // Chờ script chrome dùng chung (layout/base.html) ghi xong
                    // localStorage rồi mới đọc lại, tránh 2 script cùng tự đảo
                    // ngôn ngữ độc lập và triệt tiêu lẫn nhau trong 1 lần click.
                    setTimeout(function () {
                        setPageLanguage(getCurrentLanguageSafe());
                    }, 100);
                });
            }
        });
    })();
</script>
{% endblock %}
</file>

