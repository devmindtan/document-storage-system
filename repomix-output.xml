        "Thao tác": "Action",
        "Xóa hồ sơ": "Delete",

        "Hiện chưa có hồ sơ nào được quản lý duyệt.": "There are no approved documents yet.",
        "Không tìm thấy tài liệu phù hợp.": "No matching documents found.",
        "Đang tìm kiếm...": "Searching...",
        "Có lỗi khi tìm kiếm dữ liệu.": "An error occurred while searching data."
    };

    const PLACEHOLDER_VI_TO_EN = {
        "Nhập tên file...": "Enter file name...",
        "Nhập tên người gửi...": "Enter submitter name..."
    };

    function reverseMap(map) {
        const result = {};

        Object.keys(map).forEach(function (key) {
            result[map[key]] = key;
        });

        return result;
    }

    const EN_TO_VI = reverseMap(VI_TO_EN);
    const PLACEHOLDER_EN_TO_VI = reverseMap(PLACEHOLDER_VI_TO_EN);

    function getLanguage() {
        return localStorage.getItem("appLanguage") || "vi";
    }

    function setLanguage(language) {
        localStorage.setItem("appLanguage", language);
    }

    function normalizeText(value) {
        return String(value || "").replace(/\s+/g, " ").trim();
    }

    function translateTextNodes(language) {
        const map = language === "en" ? VI_TO_EN : EN_TO_VI;

        const walker = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT,
            {
                acceptNode: function (node) {
                    const parent = node.parentElement;

                    if (!parent) {
                        return NodeFilter.FILTER_REJECT;
                    }

                    const tagName = parent.tagName.toLowerCase();

                    if (
                        tagName === "script" ||
                        tagName === "style" ||
                        tagName === "textarea"
                    ) {
                        return NodeFilter.FILTER_REJECT;
                    }

                    if (!normalizeText(node.nodeValue)) {
                        return NodeFilter.FILTER_REJECT;
                    }

                    return NodeFilter.FILTER_ACCEPT;
                }
            }
        );

        const nodes = [];

        while (walker.nextNode()) {
            nodes.push(walker.currentNode);
        }

        nodes.forEach(function (node) {
            let originalText = node.nodeValue;
            let text = normalizeText(originalText);

            Object.keys(map).forEach(function (key) {
                if (text.includes(key)) {
                    text = text.replaceAll(key, map[key]);
                }
            });

            const leading = originalText.match(/^\s*/)[0];
            const trailing = originalText.match(/\s*$/)[0];

            node.nodeValue = leading + text + trailing;
        });
    }

    function translatePlaceholders(language) {
        const map = language === "en" ? PLACEHOLDER_VI_TO_EN : PLACEHOLDER_EN_TO_VI;

        document.querySelectorAll("input[placeholder]").forEach(function (input) {
            const currentPlaceholder = normalizeText(input.getAttribute("placeholder"));

            if (map[currentPlaceholder]) {
                input.setAttribute("placeholder", map[currentPlaceholder]);
            }
        });
    }

    function translateOptions(language) {
        const map = language === "en" ? VI_TO_EN : EN_TO_VI;

        document.querySelectorAll("option").forEach(function (option) {
            const text = normalizeText(option.textContent);

            if (map[text]) {
                option.textContent = map[text];
            }
        });
    }

    function applyApprovedLanguage(language) {
        const button = document.getElementById("languageToggle");

        document.documentElement.lang = language;

        if (button) {
            button.textContent = language === "vi" ? "EN" : "VI";
        }

        translateTextNodes(language);
        translatePlaceholders(language);
        translateOptions(language);

        setLanguage(language);
    }

    function bindApprovedLanguageButton() {
        const button = document.getElementById("languageToggle");

        if (!button) {
            return;
        }

        button.onclick = function () {
            const currentLanguage = getLanguage();
            const nextLanguage = currentLanguage === "vi" ? "en" : "vi";

            applyApprovedLanguage(nextLanguage);
        };
    }

    document.addEventListener("DOMContentLoaded", function () {
        applyApprovedLanguage(getLanguage());
        bindApprovedLanguageButton();
    });

    window.addEventListener("load", function () {
        applyApprovedLanguage(getLanguage());
        bindApprovedLanguageButton();
    });

    window.applyApprovedLanguage = applyApprovedLanguage;
})();
</script>

</body>
</html>
