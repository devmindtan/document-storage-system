    >
        <label for="project_key">Project</label>

        <select id="project_key" name="project_key" required>
            {% for key, project in projects.items() %}
                {% if selected_project_key == key %}
                    <option value="{{ key }}" selected>
                        {{ project['label'] }}
                    </option>
                {% else %}
                    <option value="{{ key }}">
                        {{ project['label'] }}
                    </option>
                {% endif %}
            {% endfor %}

            {% if selected_project_key == '__new_project__' %}
                <option value="__new_project__" selected>
                    + Tạo project mới
                </option>
            {% else %}
                <option value="__new_project__">
                    + Tạo project mới
                </option>
            {% endif %}
        </select>

        <div id="newProjectBox" class="conditional-input-box">
            <label for="new_project_name">
