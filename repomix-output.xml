        function applyApprovedLanguage(lang) {
            const button = document.getElementById("languageToggle");
            const text = PAGE_TEXT[lang] || PAGE_TEXT.vi;

            document.documentElement.lang = lang;
            document.title = text.pageTitle;

            if (button) (button.querySelector("span") || button).textContent = lang === "vi" ? "EN" : "VI";

            document.querySelectorAll("[data-i18n-key]").forEach(el => {
                const key = el.getAttribute("data-i18n-key");
                if (text[key]) el.textContent = text[key];
            });

            document.querySelectorAll("[data-i18n-placeholder-key]").forEach(el => {
                const key = el.getAttribute("data-i18n-placeholder-key");
                if (text[key]) el.setAttribute("placeholder", text[key]);
            });

            setLanguage(lang);
        }

        document.addEventListener("DOMContentLoaded", function () {
            applyApprovedLanguage(getLanguage());
            const toggle = document.getElementById("languageToggle");
            if (toggle) {
                toggle.addEventListener("click", function () {
                    // Chờ script chrome dùng chung (layout/base.html) ghi xong
                    // localStorage rồi mới đọc lại, tránh 2 script cùng tự đảo
                    // ngôn ngữ độc lập và triệt tiêu lẫn nhau trong 1 lần click.
                    setTimeout(function () {
                        applyApprovedLanguage(getLanguage());
                    }, 100);
                });
            }
        });

        window.applyApprovedLanguage = applyApprovedLanguage;
    })();
</script>
