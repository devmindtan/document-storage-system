<file path="templates/upload.html">
{% extends "layout/base.html" %}

{% block title %}Gửi hồ sơ chờ duyệt{% endblock %}
{% block page_title %}<span data-i18n-key="pageHeading">GỬI HỒ SƠ CHỜ DUYỆT</span>{% endblock %}
{% block active_nav %}upload{% endblock %}
{% block extra_style %}
<style>
    .required-star {
        color: #e11d48;
        font-weight: bold;
        margin-left: 4px;
    }

    .conditional-input-box {
        display: none;
    }

    .conditional-input-box.is-visible {
        display: block;
    }

    .custom-file-upload.is-dragover {
        background-color: #f0f5fa;
        border-color: #3b82f6;
    }
</style>
{% endblock %}

{% block content %}
{% import "layout/_macros.html" as macros %}
<div class="dashboard-box max-w-4xl mx-auto space-y-6">
    <div class="top-bar flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-500">
            <span data-i18n-key="employeeLabel">Nhân viên:</span> <strong class="text-slate-800 font-semibold">{{
                user['full_name'] }}</strong>
        </p>

        <a class="back-link inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-brand-600 transition-colors"
            href="/employee">
            <i class="ti ti-arrow-left"></i> <span data-i18n-key="backButton">Quay lại</span>
        </a>
    </div>

    {{ macros.banner('error', error) }}
    {{ macros.banner('success', success) }}

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-200 bg-slate-50/50 flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-brand-50 text-brand-500 flex items-center justify-center shrink-0">
                <i class="ti ti-cloud-upload text-xl"></i>
            </div>
            <div>
                <h2 class="text-lg font-semibold text-slate-800" data-i18n-key="cardTitle">Gửi hồ sơ mới</h2>
                <p class="text-sm text-slate-500" data-i18n-key="cardSubtitle">Điền thông tin, quản lý danh mục và đính
                    kèm tệp cần trình quản lý
                    duyệt.</p>
            </div>
        </div>

        <form action="/employee/upload" method="post" enctype="multipart/form-data" class="p-6 space-y-6">
            <div class="flex items-center gap-2">
                <span
                    class="w-6 h-6 rounded-full bg-brand-900 text-white text-xs font-bold flex items-center justify-center shrink-0">1</span>
                <h3 class="form-step-heading text-sm font-semibold text-slate-800 uppercase tracking-wide"
                    data-i18n-key="step1Heading">Chọn vị trí
                    lưu & Quản lý danh mục</h3>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label for="project_key" class="block text-sm font-medium text-slate-700"
                        data-i18n-key="projectLabel">Project</label>
                </div>

                <select id="project_key" name="project_key" required
                    class="w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 bg-white outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                    {% for key, project in projects.items() %}
                    {% if selected_project_key == key %}
                    <option value="{{ key }}" selected>{{ project['label'] }}</option>
                    {% else %}
                    <option value="{{ key }}">{{ project['label'] }}</option>
                    {% endif %}
                    {% endfor %}

                    {% if selected_project_key == new_project_key %}
                    <option value="{{ new_project_key }}" selected>+ Tạo project mới</option>
                    {% else %}
                    <option value="{{ new_project_key }}">+ Tạo project mới</option>
                    {% endif %}
                </select>

                <div id="newProjectBox"
                    class="conditional-input-box mt-3 p-3.5 border border-dashed border-brand-200 rounded-lg bg-brand-50/40">
                    <label for="new_project_name" class="block text-sm font-medium text-slate-700 mb-1.5">
                        <span data-i18n-key="newProjectNameLabel">Tên project mới</span> <span
                            class="required-star">*</span>
                    </label>
                    <input id="new_project_name" type="text" name="new_project_name" maxlength="50"
                        placeholder="Nhập tên project mới" value="{{ new_project_name_value or '' }}"
                        class="w-full border border-slate-300 rounded-lg px-3.5 py-2 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                    <p class="note-text text-xs text-slate-500 mt-1.5" data-i18n-key="newProjectNote">Project mới sẽ
                        được gửi kèm hồ sơ và chờ quản lý
                        duyệt một lần.</p>
                </div>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label for="category_key" class="block text-sm font-medium text-slate-700"
                        data-i18n-key="categoryLabel">Loại hồ sơ</label>
                </div>

                <select id="category_key" name="category_key" required
                    data-selected-category-key="{{ selected_category_key }}"
                    class="w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 bg-white outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                    <option value="">Đang tải file con...</option>
                </select>

                <div id="newCategoryBox"
                    class="conditional-input-box mt-3 p-3.5 border border-dashed border-brand-200 rounded-lg bg-brand-50/40 space-y-3">
                    <div>
                        <label for="new_category_name" class="block text-sm font-medium text-slate-700 mb-1.5">
                            <span data-i18n-key="newCategoryNameLabel">Tên file con mới</span> <span
                                class="required-star">*</span>
                        </label>
                        <input id="new_category_name" type="text" name="new_category_name" maxlength="50"
                            placeholder="Nhập tên file con mới" value="{{ new_category_name_value or '' }}"
                            class="w-full border border-slate-300 rounded-lg px-3.5 py-2 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                    </div>

                    <div>
                        <label for="new_category_code" class="block text-sm font-medium text-slate-700 mb-1.5"
                            data-i18n-key="categoryCodeLabel">Mã file
                            con</label>
                        <input id="new_category_code" type="text" name="new_category_code" maxlength="10"
                            placeholder="Ví dụ: IR, QC, LEG" value="{{ new_category_code_value or '' }}"
                            class="w-full border border-slate-300 rounded-lg px-3.5 py-2 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                    </div>

                    <p class="note-text text-xs text-slate-500" data-i18n-key="categoryCodeNote">Nếu để trống mã file
                        con, hệ thống sẽ tự tạo mã.</p>
                </div>

                <div id="codePreviewBox"
                    class="hidden mt-3 px-3.5 py-2.5 rounded-lg bg-slate-50 border border-slate-200 text-xs text-slate-500">
                    <span data-i18n-key="codePreviewLabel">Mã hồ sơ dự kiến:</span> <span id="codePreviewText"
                        class="font-mono font-semibold text-slate-700"></span>
                    <span class="text-slate-400" data-i18n-key="codePreviewNote">(có thể thay đổi tại thời điểm tải
                        lên)</span>
                </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <span
                    class="w-6 h-6 rounded-full bg-brand-900 text-white text-xs font-bold flex items-center justify-center shrink-0">2</span>
                <h3 class="form-step-heading text-sm font-semibold text-slate-800 uppercase tracking-wide"
                    data-i18n-key="step2Heading">Chọn tệp</h3>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5" data-i18n-key="chooseFileFieldLabel">Chọn
                    file</label>
                <div
                    class="custom-file-upload border-2 border-dashed border-slate-300 rounded-xl bg-slate-50 hover:bg-brand-50 transition-colors flex flex-col items-center justify-center p-8 text-center cursor-pointer">
                    <input id="uploaded_files" class="real-file-input hidden" type="file" name="uploaded_files" multiple
                        required>
                    <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center shadow-sm mb-3">
                        <i class="ti ti-cloud-upload text-2xl text-brand-500"></i>
                    </div>
                    <label
                        class="custom-file-button cursor-pointer text-sm font-semibold text-brand-600 hover:text-brand-800 underline underline-offset-2"
                        for="uploaded_files">
                        <span data-i18n-key="chooseFileBtn">Chọn tệp</span>
                    </label>
                    <span class="selected-file-text text-xs text-slate-500 mt-2" id="selectedFileText"
                        data-i18n-key="noFileSelected">Không có tệp nào
                        được chọn</span>
                </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <span
                    class="w-6 h-6 rounded-full bg-brand-900 text-white text-xs font-bold flex items-center justify-center shrink-0">3</span>
                <h3 class="form-step-heading text-sm font-semibold text-slate-800 uppercase tracking-wide"
                    data-i18n-key="step3Heading">Thông tin mô
                    tả</h3>
            </div>

            <label for="description" class="block text-sm font-medium text-slate-700 mb-1.5">
                <span data-i18n-key="descriptionLabel">Mô tả</span> <span class="required-star">*</span>
            </label>
            <input id="description" type="text" name="description" maxlength="50" required
                placeholder="Nhập mô tả hồ sơ, tối đa 50 ký tự" value="{{ description_value or '' }}"
                class="w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
            <p class="note-text text-xs text-slate-500" data-i18n-key="requiredNote">Bắt buộc nhập. Tối đa 50 ký tự.</p>

            <label for="location" class="block text-sm font-medium text-slate-700 mb-1.5">
                <span data-i18n-key="locationLabel">Vị trí</span> <span class="required-star">*</span>
            </label>
            <input id="location" type="text" name="location" maxlength="50" required
                placeholder="Nhập vị trí hồ sơ, tối đa 50 ký tự" value="{{ location_value }}"
                class="w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm text-slate-800 outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
            <p class="note-text text-xs text-slate-500" data-i18n-key="requiredNote">Bắt buộc nhập. Tối đa 50 ký tự.</p>

            <div class="pt-4 border-t border-slate-200 flex justify-end">
                <button type="submit"
                    class="primary-upload-button inline-flex items-center gap-2 px-5 py-2.5 bg-brand-900 text-white rounded-lg text-sm font-medium hover:bg-brand-800 transition-colors shadow-sm">
                    <i class="ti ti-send"></i> <span data-i18n-key="submitBtn">Gửi hồ sơ cho quản lý duyệt</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block extra_script %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const NEW_PROJECT_KEY = "__new_project__";
        const NEW_CATEGORY_KEY = "__new_category__";
        const DEFAULT_CATEGORY_PREFIX = "__default_category__:";

        const defaultCategories = [
            { id: DEFAULT_CATEGORY_PREFIX + "BC", label: "Business Case" },
            { id: DEFAULT_CATEGORY_PREFIX + "CAPEX", label: "CAPEX" },
            { id: DEFAULT_CATEGORY_PREFIX + "PTW", label: "PTW" },
            { id: DEFAULT_CATEGORY_PREFIX + "JSA", label: "JSA" },
            { id: DEFAULT_CATEGORY_PREFIX + "RAHS", label: "Risk Assessment / Hazard Study" },
            { id: DEFAULT_CATEGORY_PREFIX + "DWG", label: "Drawings" },
            { id: DEFAULT_CATEGORY_PREFIX + "FSH", label: "FAT / SAT / Handover" },
            { id: DEFAULT_CATEGORY_PREFIX + "PHOTO", label: "Photos" },
            { id: DEFAULT_CATEGORY_PREFIX + "TSOP", label: "Training / SOP" },
            { id: DEFAULT_CATEGORY_PREFIX + "LEG", label: "Legal" },
            { id: DEFAULT_CATEGORY_PREFIX + "VM", label: "Vendor Manual" },
            { id: DEFAULT_CATEGORY_PREFIX + "OTH", label: "Others" }
        ];

        const projectSelect = document.getElementById("project_key");
        const categorySelect = document.getElementById("category_key");
        const newProjectBox = document.getElementById("newProjectBox");
        const newProjectInput = document.getElementById("new_project_name");
        const newCategoryBox = document.getElementById("newCategoryBox");
        const newCategoryNameInput = document.getElementById("new_category_name");
        const fileInput = document.getElementById("uploaded_files");
        const selectedFileText = document.getElementById("selectedFileText");

        function setRequired(input, required) {
            if (!input) return;
            if (required) {
                input.setAttribute("required", "required");
            } else {
                input.removeAttribute("required");
            }
        }

        function addOption(value, label, selectedValue) {
            const option = document.createElement("option");
            option.value = value;
            option.textContent = label;
            if (String(value) === String(selectedValue)) {
                option.selected = true;
            }
            categorySelect.appendChild(option);
        }

        function updateNewProjectBox() {
            const isNewProject = projectSelect.value === NEW_PROJECT_KEY;
            newProjectBox.classList.toggle("is-visible", isNewProject);
            setRequired(newProjectInput, isNewProject);
        }

        function updateNewCategoryBox() {
            const isNewCategory = categorySelect.value === NEW_CATEGORY_KEY;
            newCategoryBox.classList.toggle("is-visible", isNewCategory);
            setRequired(newCategoryNameInput, isNewCategory);
            updateDocumentCodePreview();
        }

        function updateDocumentCodePreview() {
            const box = document.getElementById("codePreviewBox");
            const text = document.getElementById("codePreviewText");
            if (!box || !text) return;

            const projectId = projectSelect.value;
            const categoryKey = categorySelect.value;

            if (!projectId || projectId === NEW_PROJECT_KEY || !categoryKey || categoryKey === NEW_CATEGORY_KEY) {
                box.classList.add("hidden");
                return;
            }

            fetch("/document-code-preview?project_id=" + encodeURIComponent(projectId) + "&category_key=" + encodeURIComponent(categoryKey), {
                method: "GET",
                headers: { "Accept": "application/json" }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.preview_code) {
                        text.textContent = data.preview_code;
                        box.classList.remove("hidden");
                    } else {
                        box.classList.add("hidden");
                    }
                })
                .catch(() => box.classList.add("hidden"));
        }

        function loadDefaultCategoriesForNewProject(selectedCategoryKey) {
            categorySelect.innerHTML = "";
            defaultCategories.forEach(function (category) {
                addOption(category.id, category.label, selectedCategoryKey);
            });
            addOption(NEW_CATEGORY_KEY, "+ Tạo file con mới", selectedCategoryKey);
            categorySelect.disabled = false;
            if (!categorySelect.value && categorySelect.options.length > 0) {
                categorySelect.selectedIndex = 0;
            }
            categorySelect.dataset.selectedCategoryKey = categorySelect.value;
            updateNewCategoryBox();
        }

        function updateCategoryDropdown() {
            const projectId = projectSelect.value;
            const selectedCategoryKey = categorySelect.dataset.selectedCategoryKey || "";

            updateNewProjectBox();

            if (projectId === NEW_PROJECT_KEY) {
                loadDefaultCategoriesForNewProject(selectedCategoryKey);
                return;
            }

            categorySelect.innerHTML = "";
            if (!projectId) {
                addOption("", "Không có file con", "");
                categorySelect.disabled = true;
                updateNewCategoryBox();
                return;
            }

            addOption("", "Đang tải file con...", "");

            fetch("/project-categories/" + projectId, {
                method: "GET",
                headers: { "Accept": "application/json" }
            })
                .then(res => res.json())
                .then(data => {
                    categorySelect.innerHTML = "";
                    if (!data.success || !data.categories || data.categories.length === 0) {
                        addOption("", "Không có file con", "");
                        addOption(NEW_CATEGORY_KEY, "+ Tạo file con mới", selectedCategoryKey);
                        categorySelect.disabled = false;
                        updateNewCategoryBox();
                        return;
                    }

                    data.categories.forEach(function (category) {
                        addOption(category.id, category.label, selectedCategoryKey);
                    });
                    addOption(NEW_CATEGORY_KEY, "+ Tạo file con mới", selectedCategoryKey);
                    categorySelect.disabled = false;

                    if (!categorySelect.value && categorySelect.options.length > 0) {
                        categorySelect.selectedIndex = 0;
                    }
                    categorySelect.dataset.selectedCategoryKey = categorySelect.value;
                    updateNewCategoryBox();
                })
                .catch(() => {
                    categorySelect.innerHTML = "";
                    addOption("", "Không thể tải file con", "");
                    categorySelect.disabled = true;
                    updateNewCategoryBox();
                });
        }

        if (fileInput && selectedFileText) {
            fileInput.addEventListener("change", function () {
                const files = Array.from(fileInput.files);
                if (files.length === 0) {
                    selectedFileText.textContent = "Không có tệp nào được chọn";
                    return;
                }
                selectedFileText.textContent = files.length === 1 ? files[0].name : `Đã chọn ${files.length} tệp`;
            });
        }

        if (projectSelect && categorySelect) {
            projectSelect.addEventListener("change", function () {
                categorySelect.dataset.selectedCategoryKey = "";
                updateCategoryDropdown();
            });

            categorySelect.addEventListener("change", function () {
                categorySelect.dataset.selectedCategoryKey = categorySelect.value;
                updateNewCategoryBox();
            });

            updateCategoryDropdown();
        }
    });

    // ============================================================
    // PAGE-SPECIFIC TRANSLATION FIX
    // Employee Upload page
    // ============================================================

    (function () {
        const PAGE_TRANSLATIONS = {
            vi: {
                pageHeading: "GỬI HỒ SƠ CHỜ DUYỆT",
                employeeLabel: "Nhân viên:",
                backButton: "Quay lại",
                cardTitle: "Gửi hồ sơ mới",
                cardSubtitle: "Điền thông tin, quản lý danh mục và đính kèm tệp cần trình quản lý duyệt.",
                step1Heading: "Chọn vị trí lưu & Quản lý danh mục",
                projectLabel: "Project",
                newProjectNameLabel: "Tên project mới",
                newProjectNote: "Project mới sẽ được gửi kèm hồ sơ và chờ quản lý duyệt một lần.",
                categoryLabel: "Loại hồ sơ",
                newCategoryNameLabel: "Tên file con mới",
                categoryCodeLabel: "Mã file con",
                categoryCodeNote: "Nếu để trống mã file con, hệ thống sẽ tự tạo mã.",
                codePreviewLabel: "Mã hồ sơ dự kiến:",
                codePreviewNote: "(có thể thay đổi tại thời điểm tải lên)",
                step2Heading: "Chọn tệp",
                chooseFileFieldLabel: "Chọn file",
                chooseFileBtn: "Chọn tệp",
                noFileSelected: "Không có tệp nào được chọn",
                step3Heading: "Thông tin mô tả",
                descriptionLabel: "Mô tả",
                requiredNote: "Bắt buộc nhập. Tối đa 50 ký tự.",
                locationLabel: "Vị trí",
                submitBtn: "Gửi hồ sơ cho quản lý duyệt"
            },
            en: {
                pageHeading: "SUBMIT DOCUMENT FOR APPROVAL",
                employeeLabel: "Employee:",
                backButton: "Back",
                cardTitle: "Upload new document",
                cardSubtitle: "Fill in the details, manage the catalog and attach the file to send to your manager for approval.",
                step1Heading: "Select storage location & manage catalog",
                projectLabel: "Project",
                newProjectNameLabel: "New project name",
                newProjectNote: "The new project will be submitted together with the document and await manager approval once.",
                categoryLabel: "Document type",
                newCategoryNameLabel: "New sub-file name",
                categoryCodeLabel: "Sub-file code",
                categoryCodeNote: "If left blank, the system will auto-generate the code.",
                codePreviewLabel: "Expected document code:",
                codePreviewNote: "(may change at the time of upload)",
                step2Heading: "Select file",
                chooseFileFieldLabel: "Select file",
                chooseFileBtn: "Choose file",
                noFileSelected: "No file selected",
                step3Heading: "Description details",
                descriptionLabel: "Description",
                requiredNote: "Required. Maximum 50 characters.",
                locationLabel: "Location",
                submitBtn: "Submit document for approval"
            }
        };

        function getPageLanguage() {
            const savedLanguage = localStorage.getItem("appLanguage");
            if (savedLanguage === "en" || savedLanguage === "vi") {
                return savedLanguage;
            }
            return "vi";
        }

        function applyPageTranslations() {
            const currentLanguage = getPageLanguage();

            document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-key");

                if (
                    PAGE_TRANSLATIONS[currentLanguage] &&
                    PAGE_TRANSLATIONS[currentLanguage][key]
                ) {
                    element.textContent = PAGE_TRANSLATIONS[currentLanguage][key];
                }
            });
        }

        window.applyPageTranslationsFunc = applyPageTranslations;

        document.addEventListener("DOMContentLoaded", function () {
            setTimeout(applyPageTranslations, 50);

            const languageButton = document.getElementById("languageToggle");

            if (languageButton) {
                languageButton.addEventListener("click", function () {
                    setTimeout(applyPageTranslations, 100);
                });
            }
        });

        window.addEventListener("load", function () {
            setTimeout(applyPageTranslations, 50);
        });
    })();
</script>
{% endblock %}
</file>

<file path="templates/layout/base.html">
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Document Storage System{% endblock %}</title>

    <style>
        /* Chuyển trang mượt hơn (native, không cần JS): trình duyệt hỗ trợ
           View Transitions sẽ tự crossfade khi chuyển trang thường (a href,
           form GET/POST); trình duyệt không hỗ trợ vẫn chuyển trang y như
           trước, không lỗi, không cần fallback. */
        @view-transition {
            navigation: auto;
        }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- CSS Tailwind biên dịch sẵn (static/tailwind.css) thay cho script CDN
         JIT-compile lại từ đầu mỗi lần chuyển trang. Chạy `make build-css`
         sau khi thêm class Tailwind mới vào template. -->
    <link rel="stylesheet" href="/static/tailwind.css">
    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* ---- Toast (shared, dùng chung cho mọi trang) ---- */
        #toastHost {
            position: fixed;
            top: 5rem;
            right: 1rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .toast-item {
            min-width: 260px;
            max-width: 340px;
            background: #0f172a;
            color: #fff;
            padding: 0.75rem 1rem;
            border-radius: 0.75rem;
            font-size: 0.8rem;
            font-weight: 600;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .2);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            animation: toast-in .2s ease-out;
        }

        .toast-item.success {
            background: #166534;
        }

        .toast-item.danger {
            background: #b91c1c;
        }

        .toast-close {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.7);
            cursor: pointer;
            padding: 0.125rem;
            line-height: 0;
            border-radius: 0.375rem;
            flex-shrink: 0;
        }

        .toast-close:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.15);
        }

        @keyframes toast-in {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
    {% block extra_style %}{% endblock %}
</head>

<body
    class="{% block body_class %}bg-slate-50{% endblock %} text-slate-800 font-sans {% if user %}h-screen overflow-hidden flex{% else %}min-h-screen{% endif %} relative">

    {% if user %}
    <div id="toastHost"></div>

    <div id="sidebarBackdrop" class="fixed inset-0 bg-slate-900/50 z-40 hidden transition-opacity lg:hidden"
        onclick="toggleSidebar()"></div>

    <aside id="sidebar"
        class="fixed inset-y-0 left-0 z-50 w-64 bg-[#0b1329] text-slate-300 flex flex-col transition-transform duration-300 transform -translate-x-full lg:translate-x-0 lg:static lg:flex-shrink-0 border-r border-slate-800/60 font-sans">

        <!-- AkzoNobel ở sidebar, Amata Engineering ở các trang Tổng quan -->
        <div class="h-14 flex items-center justify-between px-4 shrink-0 border-b border-slate-800/60 bg-[#0b1329]">

            <a href="/"
                class="flex-1 flex items-center justify-center gap-2 whitespace-nowrap transition-transform duration-200 hover:scale-[1.01]">

                <span class="text-lg sm:text-xl font-semibold text-white tracking-tight">AkzoNobel</span>

                <span class="w-[1.5px] h-4 bg-slate-700/80 rounded-full"></span>

                <span
                    class="text-lg sm:text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-500 tracking-wider uppercase">
                    ANATA
                </span>
            </a>

            <button
                class="lg:hidden ml-2 p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 shrink-0 transition-colors outline-none"
                onclick="toggleSidebar()">
                <i class="ti ti-x text-xl"></i>
            </button>

        </div>
        {% set active_nav = self.active_nav() %}
        {% set nav_titles = {'dashboard': 'Tổng quan', 'upload': 'Gửi hồ sơ mới', 'pending': 'Chờ phê duyệt',
        'my_documents': 'Hồ sơ của tôi', 'approved': 'Kho hồ sơ đã duyệt', 'project_requests': 'Dự án chờ duyệt',
        'statistics': 'Thống kê', 'admin_dashboard': 'Admin Dashboard', 'manager_users':
        'Quản lý tài khoản', 'create_manager': 'Tạo tài khoản Quản lý', 'create_employee': 'Tạo tài khoản Nhân viên',
        'audit_logs': 'Nhật ký hoạt động'} %}
        {% set nav_icons = {'dashboard': 'ti-layout-dashboard', 'upload': 'ti-cloud-upload', 'pending':
        'ti-bell-ringing', 'my_documents': 'ti-folder', 'approved': 'ti-lock-square', 'project_requests':
        'ti-git-pull-request', 'statistics': 'ti-chart-pie', 'admin_dashboard': 'ti-settings-automation',
        'manager_users': 'ti-users-group', 'create_manager': 'ti-user-plus', 'create_employee':
        'ti-user-plus', 'audit_logs': 'ti-activity-heartbeat'} %}
        {% set is_admin_section = active_nav in ['admin_dashboard', 'manager_users', 'create_manager',
        'create_employee', 'audit_logs'] %}

        <!-- Macro dùng lại cho mọi nav item: 1 active state duy nhất (thanh trái vàng + nền nhạt) -->
        {% macro nav_link(href, key, icon, label) %}
        <a href="{{ href }}"
            class="group relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-colors
            {{ 'text-white bg-white/[0.06] font-semibold' if active_nav == key else 'text-slate-400 hover:text-white hover:bg-white/[0.04] font-medium' }}">
            {% if active_nav == key %}<span
                class="absolute left-0 top-1.5 bottom-1.5 w-[3px] bg-amber-400 rounded-full"></span>{% endif %}
            <i
                class="ti {{ icon }} text-lg shrink-0 {{ 'text-amber-400' if active_nav == key else 'opacity-80 group-hover:opacity-100' }}"></i>
            <span data-i18n="{{ key }}" class="truncate">{{ label }}</span>
            {% if key == 'pending' and pending_count is defined and pending_count %}
            <span class="ml-auto bg-amber-500 text-slate-950 text-xs font-bold px-1.5 py-0.5 rounded shrink-0">{{
                pending_count }}</span>
            {% endif %}
        </a>
        {% endmacro %}

        <!-- CTA: tách khỏi logo, khoảng cách rõ -->
        <div class="px-4 py-3 shrink-0">
            <a href="{{ '/employee/upload' if user.role == 'EMPLOYEE' else '/manager/upload' }}"
                class="relative flex items-center justify-center gap-2 w-full py-2.5 rounded-xl font-bold text-sm text-amber-950 bg-amber-400 hover:bg-amber-300 overflow-hidden transition-all shadow-[0_4px_10px_rgba(251,191,36,0.15),inset_0_1px_1px_rgba(255,255,255,0.7)] border border-amber-500/50 active:scale-[0.98]">
                <div class="absolute inset-0 bg-gradient-to-t from-black/[0.03] to-transparent pointer-events-none">
                </div>
                <i class="ti ti-plus text-lg relative z-10"></i>
                <span class="relative z-10 tracking-wide" data-i18n="upload">Gửi hồ sơ mới</span>
            </a>
        </div>

        <div
            class="flex-1 overflow-y-auto px-4 py-2 flex flex-col gap-6 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">

            <div class="space-y-0.5">
                <p data-i18n="section.workspace"
                    class="px-3 mb-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Quản lý hồ sơ</p>

                {% if user.role == 'EMPLOYEE' %}
                {{ nav_link('/employee', 'dashboard', 'ti-layout-dashboard', 'Tổng quan') }}
                {{ nav_link('/employee/my-documents', 'my_documents', 'ti-folder', 'Hồ sơ của tôi') }}
                {{ nav_link('/documents/approved', 'approved', 'ti-lock-square', 'Hồ sơ đã duyệt') }}
                {{ nav_link('/statistics', 'statistics', 'ti-chart-pie', 'Thống kê') }}
                {% else %}
                {{ nav_link('/manager', 'dashboard', 'ti-layout-dashboard', 'Tổng quan') }}
                {{ nav_link('/manager/pending', 'pending', 'ti-bell-ringing', 'Chờ phê duyệt') }}
                {{ nav_link('/manager/my-documents', 'my_documents', 'ti-folder', 'Hồ sơ của tôi') }}
                {{ nav_link('/documents/approved', 'approved', 'ti-lock-square', 'Hồ sơ đã duyệt') }}
                {{ nav_link('/manager/project-requests', 'project_requests', 'ti-git-pull-request', 'Dự án chờ duyệt')
                }}
                {{ nav_link('/statistics', 'statistics', 'ti-chart-pie', 'Thống kê') }}
                {% endif %}
            </div>

            {% if user.is_admin %}
            <div class="space-y-0.5">
                <p data-i18n="section.admin"
                    class="px-3 mb-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Quản trị hệ thống
                </p>

                {{ nav_link('/admin', 'admin_dashboard', 'ti-settings-automation', 'Admin Dashboard') }}
                {{ nav_link('/manager/users', 'manager_users', 'ti-users-group', 'Quản lý tài khoản') }}
                {{ nav_link('/admin/create-manager', 'create_manager', 'ti-user-plus', 'Tạo tài khoản Quản lý') }}
                {{ nav_link('/admin/create-employee', 'create_employee', 'ti-user-plus', 'Tạo tài khoản Nhân viên') }}
                {{ nav_link('/manager/audit-logs', 'audit_logs', 'ti-activity-heartbeat', 'Nhật ký hoạt động') }}
            </div>
            {% endif %}

        </div>

        <div class="p-3 border-t border-slate-800/60 shrink-0">
            <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-white/[0.03] transition-colors">
                <img src="https://ui-avatars.com/api/?name={{ (user.full_name or user.username) | urlencode }}&background=1b4d78&color=fff&bold=true"
                    alt="{{ user.full_name }}" class="w-9 h-9 rounded-lg border border-white/10 object-cover shrink-0">

                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-slate-100 truncate">{{ user.full_name or user.username }}</p>
                    <p class="text-[10px] text-slate-500 truncate font-mono mt-0.5 tracking-wide font-semibold">{{
                        'ADMIN' if user.is_admin else ('MANAGER' if user.role == 'MANAGER' else 'EMPLOYEE') }}</p>
                </div>

                <a href="/logout" data-i18n-title="logout"
                    class="text-slate-400 hover:text-rose-400 p-1.5 rounded-lg hover:bg-rose-500/10 transition-colors shrink-0"
                    title="Đăng xuất">
                    <i class="ti ti-logout text-lg"></i>
                </a>
            </div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 bg-slate-50 relative z-0">
        <header
            class="h-16 lg:h-[72px] bg-white/80 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-4 sm:px-6 lg:px-8 shrink-0 sticky top-0 z-30 transition-all">

            <div class="flex items-center gap-4 min-w-0">
                <button
                    class="lg:hidden w-10 h-10 flex items-center justify-center rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 active:scale-95 transition-all shrink-0 outline-none"
                    onclick="toggleSidebar()">
                    <i class="ti ti-menu-2 text-2xl"></i>
                </button>

                <div
                    class="hidden sm:flex w-11 h-11 rounded-xl bg-gradient-to-br from-white to-slate-50 border border-slate-200/80 text-slate-600 shadow-sm items-center justify-center shrink-0">
                    <i class="ti {{ nav_icons.get(active_nav, 'ti-layout-dashboard') }} text-xl drop-shadow-sm"></i>
                </div>

                <div class="min-w-0 flex flex-col justify-center mt-0.5">
                    <p data-i18n="{{ 'section.admin' if is_admin_section else 'section.workspace' }}"
                        class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none mb-1.5 flex items-center gap-1.5">
                        <span class="w-1 h-1 rounded-full bg-amber-400 inline-block"></span>
                        {{ 'Quản trị hệ thống' if is_admin_section else 'Quản lý hồ sơ' }}
                    </p>
                    <h1 data-i18n="{{ active_nav }}"
                        class="text-lg sm:text-xl font-extrabold text-slate-800 tracking-tight leading-none truncate">
                        {{ nav_titles.get(active_nav, '') }}
                    </h1>
                </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
                <button id="languageToggle" type="button"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900 hover:border-slate-300 transition-all text-xs font-bold shadow-sm outline-none group">
                    <i
                        class="ti ti-language text-base text-slate-400 group-hover:text-amber-500 group-hover:rotate-12 transition-all"></i>
                    <span>VI</span>
                </button>
            </div>
        </header>

        <div class="flex-1 overflow-auto p-4 sm:p-6 lg:p-8">
            <div class="max-w-7xl mx-auto">
                {% block content %}{% endblock %}
            </div>
        </div>
    </main>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            sidebar.classList.toggle('-translate-x-full');
            if (sidebar.classList.contains('-translate-x-full')) {
                backdrop.classList.add('hidden'); backdrop.classList.remove('block');
            } else {
                backdrop.classList.remove('hidden'); backdrop.classList.add('block');
            }
        }
    </script>

    <script>
        function showToast(message, type = 'success') {
            const host = document.getElementById("toastHost");
            if (!host) return;

            const el = document.createElement("div");
            el.className = `toast-item ${type}`;

            const iconClass = type === 'danger' ? 'ti-circle-x' : (type === 'info' ? 'ti-info-circle' : 'ti-circle-check');
            const icon = document.createElement("i");
            icon.className = `ti ${iconClass} text-base shrink-0`;
            el.appendChild(icon);

            // textContent (không phải innerHTML) để tránh chèn HTML lạ từ
            // dữ liệu có thể do người dùng nhập (vd: tên file upload).
            const text = document.createElement("span");
            text.className = "flex-1";
            text.textContent = message;
            el.appendChild(text);

            const closeBtn = document.createElement("button");
            closeBtn.type = "button";
            closeBtn.className = "toast-close";
            closeBtn.setAttribute("aria-label", "Đóng thông báo");
            closeBtn.innerHTML = '<i class="ti ti-x"></i>';
            el.appendChild(closeBtn);

            host.appendChild(el);

            let dismissed = false;
            function dismiss() {
                if (dismissed) return;
                dismissed = true;
                el.style.opacity = "0";
                el.style.transition = "opacity .2s ease";
                setTimeout(() => el.remove(), 200);
            }
            closeBtn.addEventListener("click", dismiss);
            setTimeout(dismiss, 5000);
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("[data-toast-text]").forEach(function (el) {
                const message = el.getAttribute("data-toast-text");
                const kind = el.getAttribute("data-toast-kind") === "error" ? "danger" : "success";
                if (message) showToast(message, kind);
            });
        });
    </script>

    <script>
        (function () {
            const CHROME_TEXT = {
                vi: {
                    'section.workspace': 'Quản lý hồ sơ', 'section.admin': 'Quản trị hệ thống',
                    dashboard: 'Tổng quan', upload: 'Gửi hồ sơ mới', pending: 'Chờ phê duyệt',
                    my_documents: 'Hồ sơ của tôi', approved: 'Hồ sơ đã duyệt', project_requests: 'Dự án chờ duyệt',
                    statistics: 'Thống kê', admin_dashboard: 'Admin Dashboard',
                    manager_users: 'Quản lý tài khoản', create_manager: 'Tạo tài khoản Quản lý',
                    create_employee: 'Tạo tài khoản Nhân viên',
                    audit_logs: 'Nhật ký hoạt động', logout: 'Đăng xuất'
                },
                en: {
                    'section.workspace': 'Document Workspace', 'section.admin': 'Administration',
                    dashboard: 'Overview', upload: 'Upload New Document', pending: 'Pending Approval',
                    my_documents: 'My Documents', approved: 'Approved Archive', project_requests: 'Project Requests',
                    statistics: 'Statistics', admin_dashboard: 'Admin Dashboard',
                    manager_users: 'Account Management', create_manager: 'Create Manager Account',
                    create_employee: 'Create Employee Account',
                    audit_logs: 'Activity Log', logout: 'Log out'
                }
            };

            function getChromeLanguage() {
                const saved = localStorage.getItem('appLanguage');
                return (saved === 'en' || saved === 'vi') ? saved : 'vi';
            }

            function applyChromeLanguage(language) {
                const dict = CHROME_TEXT[language];
                document.querySelectorAll('[data-i18n]').forEach(function (el) {
                    const key = el.getAttribute('data-i18n');
                    if (dict[key] !== undefined) el.textContent = dict[key];
                });
                document.querySelectorAll('[data-i18n-title]').forEach(function (el) {
                    const key = el.getAttribute('data-i18n-title');
                    if (dict[key] !== undefined) el.setAttribute('title', dict[key]);
                });
                const toggle = document.getElementById('languageToggle');
                if (toggle) {
                    const label = toggle.querySelector('span') || toggle;
                    label.textContent = language === 'vi' ? 'EN' : 'VI';
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                applyChromeLanguage(getChromeLanguage());
                const toggle = document.getElementById('languageToggle');
                if (toggle) {
                    toggle.addEventListener('click', function () {
                        const next = getChromeLanguage() === 'vi' ? 'en' : 'vi';
                        localStorage.setItem('appLanguage', next);
                        applyChromeLanguage(next);
                    });
                }
            });
        })();
    </script>
    {% else %}
    <div class="min-h-screen w-full relative">
        {{ self.content() }}
    </div>
    {% endif %}

    {% block extra_script %}{% endblock %}
</body>

</html>
</file>

</files>
