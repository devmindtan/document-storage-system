                name="uploaded_files"
                multiple
                required
            >

            <label
                class="custom-file-button"
                for="uploaded_files"
            >
                Chọn tệp
            </label>

            <span
                class="selected-file-text"
                id="selectedFileText"
            >
                Không có tệp nào được chọn
            </span>
        </div>

        <label for="description">
            Mô tả <span class="required-star">*</span>
        </label>

        <input
            id="description"
            type="text"
            name="description"
            maxlength="50"
            required
            aria-required="true"
            placeholder="Nhập mô tả hồ sơ, tối đa 50 ký tự"
