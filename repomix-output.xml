    </div>

    <button class="language-toggle" id="languageToggle" type="button">
        EN
    </button>
</div>

<div class="dashboard-box">
    <div class="top-bar">
        <div>
            <h1>QUẢN LÝ UPLOAD HỒ SƠ</h1>
