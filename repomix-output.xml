        <p class="note-text">
            Bắt buộc nhập. Tối đa 50 ký tự.
        </p>

        <label for="location">
            Vị trí <span class="required-star">*</span>
        </label>

        <input
            id="location"
            type="text"
            name="location"
            maxlength="50"
            required
            aria-required="true"
            placeholder="Nhập vị trí hồ sơ, tối đa 50 ký tự"
            value="{{ location_value }}"
            oninvalid="this.setCustomValidity('Vui lòng nhập vị trí hồ sơ.')"
            oninput="this.setCustomValidity('')"
        >

        <p class="note-text">
            Bắt buộc nhập. Tối đa 50 ký tự.
        </p>

        <button type="submit" class="primary-upload-button">
    Upload và duyệt ngay
</button>
