            </p>
        </div>

        <a class="logout-button" href="/manager">
            Quay lại
        </a>
    </div>

    <hr>

    {% if error %}
        <p class="error-message">
            {{ error }}
        </p>
    {% endif %}

    {% if success %}
        <p class="success-message">
            {{ success }}
        </p>
    {% endif %}

    <form
        action="/manager/upload"
        method="post"
        enctype="multipart/form-data"
    >
        <label for="project_key">Project</label>

        <select id="project_key" name="project_key" required>
            {% for key, project in projects.items() %}
                {% if selected_project_key == key %}
                    <option value="{{ key }}" selected>
                        {{ project['label'] }}
                    </option>
                {% else %}
                    <option value="{{ key }}">
                        {{ project['label'] }}
                    </option>
                {% endif %}
            {% endfor %}

            {% if selected_project_key == '__new_project__' %}
                <option value="__new_project__" selected>
                    + Tạo project mới
                </option>
            {% else %}
                <option value="__new_project__">
                    + Tạo project mới
                </option>
            {% endif %}
        </select>

        <div id="newProjectBox" class="conditional-input-box">
            <label for="new_project_name">
                Tên project mới <span class="required-star">*</span>
            </label>

            <input
                id="new_project_name"
                type="text"
                name="new_project_name"
                maxlength="50"
                placeholder="Nhập tên project mới"
                value="{{ new_project_name_value or '' }}"
            >

            <p class="note-text">
                Project mới sẽ được tạo ngay khi quản lý upload hồ sơ.
            </p>
        </div>

        <label for="category_key">Loại hồ sơ</label>

        <select
            id="category_key"
            name="category_key"
            required
            data-selected-category-key="{{ selected_category_key }}"
        >
            <option value="">Đang tải file con...</option>
        </select>

        <div id="newCategoryBox" class="conditional-input-box">
            <label for="new_category_name">
                Tên file con mới <span class="required-star">*</span>
            </label>

            <input
                id="new_category_name"
                type="text"
                name="new_category_name"
                maxlength="50"
                placeholder="Nhập tên file con mới"
                value="{{ new_category_name_value or '' }}"
            >

            <label for="new_category_code">
                Mã file con
            </label>

            <input
                id="new_category_code"
                type="text"
                name="new_category_code"
                maxlength="10"
                placeholder="Ví dụ: IR, QC, LEG"
                value="{{ new_category_code_value or '' }}"
            >

            <p class="note-text">
                Nếu để trống mã file con, hệ thống sẽ tự tạo mã.
            </p>
        </div>

        <label>
