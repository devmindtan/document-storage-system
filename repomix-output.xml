                    class="w-full px-3 py-3 border border-slate-300 rounded-lg text-sm bg-white outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 transition-all">

                <button type="submit" id="loginButton"
                    class="w-full mt-8 py-3 bg-brand-900 hover:bg-brand-800 text-white rounded-lg font-semibold text-base shadow-sm transition-colors">Đăng
                    nhập</button>
            </form>

            <p class="text-center text-sm mt-5">
                <span id="noAccountText" class="text-slate-600">Chưa có tài khoản?</span>
                <a href="/register" id="registerNow" class="text-brand-700 font-bold hover:underline">Đăng ký ngay</a>
            </p>
        </div>
    </div>
</div>

<div id="loginClock"
    class="fixed right-6 bottom-4 bg-white/85 text-brand-900 font-bold text-lg px-3.5 py-2 rounded-lg shadow-md z-[9999]">
    --/--/---- --:--:--</div>

<script>
    function updateLoginClock() {
        const now = new Date();
        const day = String(now.getDate()).padStart(2, "0");
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const year = now.getFullYear();
        const hours = String(now.getHours()).padStart(2, "0");
        const minutes = String(now.getMinutes()).padStart(2, "0");
        const seconds = String(now.getSeconds()).padStart(2, "0");
        const clock = document.getElementById("loginClock");
        if (clock) {
            clock.textContent = `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
        }
    }
    updateLoginClock();
    setInterval(updateLoginClock, 1000);
</script>

<script>
    (function () {
        const LOGIN_TEXT = {
            vi: {
                pageTitle: "Đăng nhập hệ thống hồ sơ", loginTitle: "HỆ THỐNG LƯU TRỮ HỒ SƠ",
                loginSubtitle: "Đăng nhập để truy cập hệ thống.", usernameLabel: "Tên đăng nhập",
                usernamePlaceholder: "Nhập tên đăng nhập", passwordLabel: "Mật khẩu",
                passwordPlaceholder: "Nhập mật khẩu", loginButton: "Đăng nhập",
                noAccountText: "Chưa có tài khoản?", registerNow: "Đăng ký ngay"
            },
            en: {
                pageTitle: "Document storage system login", loginTitle: "DOCUMENT STORAGE SYSTEM",
                loginSubtitle: "Log in to access the system.", usernameLabel: "Username",
                usernamePlaceholder: "Enter username", passwordLabel: "Password",
                passwordPlaceholder: "Enter password", loginButton: "Log in",
                noAccountText: "Don't have an account?", registerNow: "Register now"
            }
        };

        function getLoginLanguage() {
            const savedLanguage = localStorage.getItem("appLanguage");
            return (savedLanguage === "en" || savedLanguage === "vi") ? savedLanguage : "vi";
        }
        function saveLoginLanguage(language) { localStorage.setItem("appLanguage", language); }
        function setTextById(id, value) { const el = document.getElementById(id); if (el) el.textContent = value; }
        function setPlaceholderById(id, value) { const el = document.getElementById(id); if (el) el.setAttribute("placeholder", value); }

        function applyLoginLanguage(language) {
            const text = LOGIN_TEXT[language];
            const languageButton = document.getElementById("languageToggle");
            document.documentElement.lang = language;
            document.title = text.pageTitle;
            if (languageButton) languageButton.textContent = language === "vi" ? "EN" : "VI";
            setTextById("loginTitle", text.loginTitle);
            setTextById("loginSubtitle", text.loginSubtitle);
            setTextById("usernameLabel", text.usernameLabel);
            setPlaceholderById("username", text.usernamePlaceholder);
            setTextById("passwordLabel", text.passwordLabel);
            setPlaceholderById("password", text.passwordPlaceholder);
            setTextById("loginButton", text.loginButton);
            setTextById("noAccountText", text.noAccountText);
            setTextById("registerNow", text.registerNow);
            saveLoginLanguage(language);
        }

        document.addEventListener("DOMContentLoaded", function () {
            applyLoginLanguage(getLoginLanguage());
            const languageButton = document.getElementById("languageToggle");
            if (languageButton) {
                languageButton.onclick = function () {
                    applyLoginLanguage(getLoginLanguage() === "vi" ? "en" : "vi");
                };
            }
        });

        window.applyLoginLanguage = applyLoginLanguage;
    })();
</script>
{% endblock %}
</file>

<file path="templates/manager_my_documents.html">
{% extends "layout/base.html" %}

{% block title %}Hồ sơ của tôi{% endblock %}
{% block page_title %}<span data-i18n-key="myDocumentsTitle">Hồ sơ của tôi</span>{% endblock %}
{% block active_nav %}my_documents{% endblock %}

{% block content %}
<div class="space-y-6 animate-fade-in">
    <p class="text-sm text-slate-500">

        <span data-i18n-key="managerLabel">Quản lý:</span>

        <span class="font-semibold text-slate-700">{{ user['full_name'] }}</span>

    </p>

    {% if documents %}
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap table-fixed">
                <thead
                    class="bg-slate-50 border-b border-slate-200 text-slate-700 uppercase font-bold text-[11px] tracking-wider">
                    <tr>
                        <th class="px-4 py-4 w-32" data-i18n-key="idHeader">ID</th>
                        <th class="px-4 py-4 w-auto" data-i18n-key="fileNameHeader">Tên file</th>
                        <th class="px-4 py-4 w-28" data-i18n-key="projectHeader">Project</th>
                        <th class="px-4 py-4 w-28" data-i18n-key="typeHeader">Loại</th>
                        <th class="px-4 py-4 w-44" data-i18n-key="submittedAtHeader">Ngày gửi</th>
                        <th class="px-4 py-4 w-32" data-i18n-key="statusHeader">Trạng thái</th>
                        <th class="px-4 py-4 w-28 text-center" data-i18n-key="actionHeader">Thao tác</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    {% for document in documents %}
                    <tr class="hover:bg-slate-50/80 transition-colors group">
                        <td class="px-4 py-4 font-mono text-brand-500 font-semibold text-xs truncate max-w-[10rem]"
                            title="{{ document['document_code'] or document['id'] }}">
                            {{ document['document_code'] or document['id'] }}
                        </td>

                        <td class="px-4 py-4 font-medium text-slate-800 truncate"
                            title="{{ document['original_name'] }}">
                            <span class="flex items-center gap-2 truncate">
                                <i class="ti ti-file-text text-slate-400 text-lg shrink-0"></i>
                                <span class="truncate">{{ document['original_name'] }}</span>
                            </span>
                        </td>

                        <td class="px-4 py-4 text-slate-500 truncate" title="{{ document['project'] or 'Project 1' }}">
                            <span class="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-medium">{{
                                document['project'] or 'Project 1' }}</span>
                        </td>

                        <td class="px-4 py-4 text-slate-600 truncate" title="{{ document['category'] }}">
                            {{ document['category'] }}
                        </td>

                        <td class="px-4 py-4 text-slate-500 truncate" title="{{ document['submitted_at'] }}">
                            {{ document['submitted_at'] }}
                        </td>

                        <td class="px-4 py-4">
                            {% if document['status'] == 'PENDING' %}
                            <span class="bg-amber-100 text-amber-700 px-2.5 py-1 rounded text-xs font-bold"
                                data-i18n-key="pendingStatus">Chờ duyệt</span>
                            {% elif document['status'] == 'APPROVED' %}
                            <span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded text-xs font-bold"
                                data-i18n-key="approvedStatus">Đã duyệt</span>
                            {% elif document['status'] == 'REJECTED' %}
                            <span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded text-xs font-bold"
                                data-i18n-key="rejectedStatus">Từ chối</span>
                            {% else %}
                            <span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded text-xs font-bold"
                                data-i18n-key="unknownStatus">Không rõ</span>
                            {% endif %}
                        </td>

                        <td class="px-4 py-4 text-center">
                            <button type="button" data-code="{{ document['document_code'] or document['id'] }}"
                                data-name="{{ document['original_name'] }}"
                                data-project="{{ document['project'] or 'Project 1' }}"
                                data-category="{{ document['category'] }}" data-date="{{ document['submitted_at'] }}"
                                data-status="{{ document['status'] }}"
                                data-reviewer="{{ document['reviewed_by'] or '-' }}"
                                data-reason="{{ document['rejection_reason'] or '-' }}"
                                onclick="openDocumentModal(this)"
                                class="text-slate-500 hover:text-brand-900 px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-semibold inline-flex items-center gap-1 shadow-sm transition-all shrink-0"
                                title="Xem chi tiết">
                                <i class="ti ti-eye"></i> <span data-i18n-key="detailBtn">Chi tiết</span>
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% else %}
    <div
        class="bg-white rounded-2xl border border-slate-200 shadow-sm p-12 flex flex-col items-center justify-center text-center space-y-3">
        <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-2">
            <i class="ti ti-folder-x text-3xl"></i>
        </div>
        <p class="text-slate-500 font-medium" data-i18n-key="noManagerDocuments">Bạn chưa upload hồ sơ nào.</p>
    </div>
    {% endif %}
</div>

<div id="documentDetailsModal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 hidden backdrop-blur-sm opacity-0 transition-opacity duration-300"
    onclick="closeDocumentModal()">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-lg transform scale-95 transition-transform duration-300 overflow-hidden"
        onclick="event.stopPropagation()">

        <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-800 flex items-center justify-center">
                    <i class="ti ti-file-info text-base"></i>
                </div>
                <h4 class="font-bold text-slate-800" data-i18n-key="modalTitle">Chi tiết hồ sơ</h4>
            </div>
            <button onclick="closeDocumentModal()"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 transition-colors">
                <i class="ti ti-x text-lg"></i>
            </button>
        </div>

        <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="idHeader">ID</span>
                <span id="modal_doc_code" class="col-span-2 text-sm font-mono font-bold text-brand-600"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="fileNameHeader">Tên file</span>
                <span id="modal_original_name" class="col-span-2 text-sm font-semibold text-slate-800 break-all"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="projectHeader">Project</span>
                <span id="modal_project" class="col-span-2 text-sm text-slate-700"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="typeHeader">Loại hồ sơ</span>
                <div><span id="modal_category"
                        class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded-md text-xs font-medium"></span></div>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="submittedAtHeader">Ngày gửi</span>
                <span id="modal_submitted_at" class="col-span-2 text-sm text-slate-700"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100 items-center">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="statusHeader">Trạng thái</span>
                <div id="modal_status_badge" class="col-span-2"></div>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="approvedByHeader">Người duyệt</span>
                <span id="modal_reviewed_by" class="col-span-2 text-sm text-slate-700"></span>
            </div>

            <div id="modal_rejection_container" class="space-y-1.5 pt-1 hidden">
                <span class="text-xs font-semibold text-rose-500 uppercase tracking-wider block"
                    data-i18n-key="rejectionReasonHeader">Lý do từ chối</span>
                <div id="modal_rejection_reason"
                    class="text-sm text-rose-700 bg-rose-50 p-3 rounded-xl border border-rose-100 min-h-[60px] whitespace-pre-wrap leading-relaxed">
                </div>
            </div>
        </div>

        <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-200 flex justify-end gap-2">
            <button onclick="closeDocumentModal()"
                class="px-5 py-2 border border-slate-200 text-slate-600 bg-white rounded-xl text-sm font-semibold hover:bg-slate-100 transition-colors shadow-sm"
                data-i18n-key="closeBtn">Đóng</button>
        </div>
    </div>
</div>

<script>
    // --- LOGIC CHO MODAL ---
    function openDocumentModal(btn) {
        const modal = document.getElementById('documentDetailsModal');
        const box = modal.querySelector('div');

        document.getElementById('modal_doc_code').textContent = btn.dataset.code || '-';
        document.getElementById('modal_original_name').textContent = btn.dataset.name || '-';
        document.getElementById('modal_project').textContent = btn.dataset.project || '-';
        document.getElementById('modal_category').textContent = btn.dataset.category || '-';
        document.getElementById('modal_submitted_at').textContent = btn.dataset.date || '-';
        document.getElementById('modal_reviewed_by').textContent = btn.dataset.reviewer || '-';

        // Render Badge Trạng Thái
        const status = btn.dataset.status;
        const badgeContainer = document.getElementById('modal_status_badge');
        const rejectionContainer = document.getElementById('modal_rejection_container');

        if (status === 'PENDING') {
            badgeContainer.innerHTML = '<span class="bg-amber-100 text-amber-700 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="pendingStatus">Chờ duyệt</span>';
            rejectionContainer.classList.add('hidden');
        } else if (status === 'APPROVED') {
            badgeContainer.innerHTML = '<span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="approvedStatus">Đã duyệt</span>';
            rejectionContainer.classList.add('hidden');
        } else if (status === 'REJECTED') {
            badgeContainer.innerHTML = '<span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="rejectedStatus">Từ chối</span>';
            document.getElementById('modal_rejection_reason').textContent = btn.dataset.reason || '-';
            rejectionContainer.classList.remove('hidden');
        } else {
            badgeContainer.innerHTML = '<span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded text-xs font-bold" data-i18n-key="unknownStatus">Không rõ</span>';
            rejectionContainer.classList.add('hidden');
        }

        // Kích hoạt dịch lại bên trong Modal
        if (typeof window.applyPageTranslationsFunc === 'function') {
            window.applyPageTranslationsFunc();
        }

        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            box.classList.remove('scale-95');
        }, 10);
    }

    function closeDocumentModal() {
        const modal = document.getElementById('documentDetailsModal');
        const box = modal.querySelector('div');

        modal.classList.add('opacity-0');
        box.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    // ============================================================
    // PAGE-SPECIFIC TRANSLATION FIX
    // Manager My Documents page
    // ============================================================

    (function () {
        const PAGE_TRANSLATIONS = {
            vi: {
                myDocumentsTitle: "HỒ SƠ CỦA TÔI",
                managerLabel: "Quản lý:",
                backButton: "Quay lại",
                idHeader: "ID",
                fileNameHeader: "Tên file",
                projectHeader: "Project",
                typeHeader: "Loại",
                submittedAtHeader: "Ngày gửi",
                statusHeader: "Trạng thái",
                approvedByHeader: "Người duyệt",
                rejectionReasonHeader: "Lý do từ chối",
                pendingStatus: "Chờ duyệt",
                approvedStatus: "Đã duyệt",
                rejectedStatus: "Bị từ chối",
                unknownStatus: "Không rõ",
                noManagerDocuments: "Bạn chưa upload hồ sơ nào.",
                actionHeader: "Thao tác",
                detailBtn: "Chi tiết",
                modalTitle: "Chi tiết hồ sơ",
                closeBtn: "Đóng"
            },
            en: {
                myDocumentsTitle: "MY DOCUMENTS",
                managerLabel: "Manager:",
                backButton: "Back",
                idHeader: "ID",
                fileNameHeader: "File name",
                projectHeader: "Project",
                typeHeader: "Type",
                submittedAtHeader: "Submitted at",
                statusHeader: "Status",
                approvedByHeader: "Approved by",
                rejectionReasonHeader: "Rejection reason",
                pendingStatus: "Pending",
                approvedStatus: "Approved",
                rejectedStatus: "Rejected",
                unknownStatus: "Unknown",
                noManagerDocuments: "You have not uploaded any documents yet.",
                actionHeader: "Action",
                detailBtn: "Details",
                modalTitle: "Document Details",
                closeBtn: "Close"
            }
        };

        function getPageLanguage() {
            const savedLanguage = localStorage.getItem("appLanguage");
            if (savedLanguage === "en" || savedLanguage === "vi") {
                return savedLanguage;
            }
            return "vi";
        }

        function applyPageTranslations() {
            const currentLanguage = getPageLanguage();

            document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-key");

                if (
                    PAGE_TRANSLATIONS[currentLanguage] &&
                    PAGE_TRANSLATIONS[currentLanguage][key]
                ) {
                    element.textContent = PAGE_TRANSLATIONS[currentLanguage][key];
                }
            });
        }

        // Lưu global để trigger bên trong event Modal
        window.applyPageTranslationsFunc = applyPageTranslations;

        document.addEventListener("DOMContentLoaded", function () {
            setTimeout(applyPageTranslations, 50);

            const languageButton = document.getElementById("languageToggle");

            if (languageButton) {
                languageButton.addEventListener("click", function () {
                    setTimeout(applyPageTranslations, 100);
                });
            }
        });

        window.addEventListener("load", function () {
            setTimeout(applyPageTranslations, 50);
        });
    })();
</script>
{% endblock %}
</file>

<file path="templates/manager_pending.html">
{% extends "layout/base.html" %}

{% block title %}Hồ sơ chờ duyệt{% endblock %}
