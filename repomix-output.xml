                colTotal: "Tổng đã upload",
                colApproved: "Đã duyệt",
                colPending: "Chờ duyệt",
                colRejected: "Từ chối",
                emptyMessage: "Chưa có tài liệu nào được upload."
            },

            en: {
                pageTitle: "Upload statistics",
                pageHeading: "Upload statistics",
                backButton: "Back",
                totalLabel: "Total documents",
                approvedLabel: "Approved",
                pendingLabel: "Pending",
                rejectedLabel: "Rejected",
                monthlyChartTitle: "Monthly uploaded documents",
                statusChartTitle: "Status ratio",
                userTableTitle: "Uploaded documents by user",
                colStt: "No.",
                colFullName: "Full name",
                colUsername: "Username",
                colTotal: "Total uploaded",
                colApproved: "Approved",
                colPending: "Pending",
                colRejected: "Rejected",
                emptyMessage: "No documents have been uploaded yet."
            }
        };

        function getLanguage() {
            return localStorage.getItem("appLanguage") || "vi";
        }

        function setLanguage(language) {
            localStorage.setItem("appLanguage", language);
        }

        function applyStatisticsLanguage(language) {
            const button = document.getElementById("languageToggle");
            const text = PAGE_TEXT[language] || PAGE_TEXT.vi;

            document.documentElement.lang = language;
            document.title = text.pageTitle;

            if (button) {
                (button.querySelector("span") || button).textContent = language === "vi" ? "EN" : "VI";
            }

            document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-key");
                if (text[key]) {
                    element.textContent = text[key];
                }
            });

            if (window.statsDoughnutChart) {
                window.statsDoughnutChart.data.labels = language === "vi"
                    ? ["Đã duyệt", "Chờ duyệt", "Từ chối"]
                    : ["Approved", "Pending", "Rejected"];
                window.statsDoughnutChart.update();
            }

            setLanguage(language);
        }

        function bindStatisticsLanguageButton() {
            const button = document.getElementById("languageToggle");
            if (!button) return;

            button.addEventListener("click", function () {
                // Chờ script chrome dùng chung (layout/base.html) ghi xong
                // localStorage rồi mới đọc lại, tránh 2 script cùng tự đảo
                // ngôn ngữ độc lập và triệt tiêu lẫn nhau trong 1 lần click.
                setTimeout(function () {
                    applyStatisticsLanguage(getLanguage());
                }, 100);
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            applyStatisticsLanguage(getLanguage());
            bindStatisticsLanguageButton();
        });
    })();
</script>
{% endblock %}
</file>

<file path="templates/admin_create_manager.html">
{% extends "layout/base.html" %}

{% block title %}Tạo tài khoản quản lý{% endblock %}
{% block page_title %}Tạo tài khoản Quản lý{% endblock %}
