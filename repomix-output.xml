</file>

<file path="templates/approved_documents.html">
{% extends "layout/base.html" %}

{% block title %}Kho hồ sơ đã được duyệt{% endblock %}
{% block page_title %}<span data-i18n-key="pageHeading">Kho hồ sơ đã được duyệt</span>{% endblock %}
{% block active_nav %}approved{% endblock %}

{% block content %}
<div class="space-y-6 animate-fade-in">
    {% import "layout/_macros.html" as macros %}
    {{ macros.banner('error', error) }}

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
            <div
                class="w-12 h-12 rounded-xl bg-brand-50 text-brand-800 flex items-center justify-center shrink-0 shadow-sm">
                <i class="ti ti-briefcase text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium text-slate-500" data-i18n-key="totalProjectsLabel">Tổng số project hiện có
                </p>
                <h3 class="text-xl font-bold text-slate-800 mt-0.5">{{ total_project_count }}</h3>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
            <div
                class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 shadow-sm">
                <i class="ti ti-files text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium text-slate-500" data-i18n-key="totalUploadedDocumentsLabel">Tổng số tài
                    liệu đã upload</p>
                <h3 class="text-xl font-bold text-slate-800 mt-0.5">{{ total_uploaded_documents }}</h3>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center gap-4">
            <div
                class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 shadow-sm">
                <i class="ti ti-check text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium text-slate-500" data-i18n-key="totalApprovedDocumentsLabel">Tài liệu đã
                    được duyệt</p>
                <h3 class="text-xl font-bold text-slate-800 mt-0.5">{{ total_approved_documents }}</h3>
            </div>
        </div>
    </div>

    <form id="approvedSearchForm" class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4"
        action="/documents/approved" method="get">
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4">

            <div class="lg:col-span-1">
                <label for="keyword" class="block text-xs font-semibold text-slate-500 mb-1.5"
                    data-i18n-key="keywordLabel">Tên file</label>
                <div class="relative">
                    <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input id="keyword" type="text" name="keyword" value="{{ filters['keyword'] or '' }}"
                        placeholder="Nhập tên file..." data-i18n-placeholder-key="keywordPlaceholder"
                        class="w-full pl-9 pr-3 py-2 border border-slate-200 rounded-xl text-sm outline-none bg-slate-50/50 focus:border-brand-500 focus:bg-white transition-all">
                </div>
            </div>

            <div class="lg:col-span-1">
                <label for="project" class="block text-xs font-semibold text-slate-500 mb-1.5"
                    data-i18n-key="projectLabel">Project</label>
                <select id="project" name="project"
                    class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm outline-none bg-slate-50/50 focus:border-brand-500 focus:bg-white transition-all">
                    <option value="" data-project-id="" data-i18n-key="allProjectsOption">Tất cả project</option>
                    {% for key, item in projects.items() %}
                    <option value="{{ item['label'] }}" data-project-id="{{ key }}" {% if
                        filters['project']==item['label'] %}selected{% endif %}>{{ item['label'] }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="lg:col-span-1">
                <label for="category" class="block text-xs font-semibold text-slate-500 mb-1.5"
                    data-i18n-key="categoryLabel">Loại hồ sơ</label>
                <select id="category" name="category" data-selected-category="{{ filters['category'] or '' }}"
                    class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm outline-none bg-slate-50/50 focus:border-brand-500 focus:bg-white transition-all">
                    <option value="" data-i18n-key="allCategoriesOption">Tất cả loại</option>
                    {% for key, item in categories.items() %}
                    <option value="{{ item['label'] }}" data-project-id="{{ key }}" {% if
                        filters['category']==item['label'] %}selected{% endif %}>{{ item['label'] }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="lg:col-span-1">
                <label for="submitted_by" class="block text-xs font-semibold text-slate-500 mb-1.5"
                    data-i18n-key="submittedByLabel">Người gửi</label>
                <input id="submitted_by" type="text" name="submitted_by" value="{{ filters['submitted_by'] or '' }}"
                    placeholder="Tên người gửi..." data-i18n-placeholder-key="submittedByPlaceholder"
                    class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm outline-none bg-slate-50/50 focus:border-brand-500 focus:bg-white transition-all">
            </div>

            <div class="md:col-span-2 lg:col-span-2">
                <label class="block text-xs font-semibold text-slate-500 mb-1.5" data-i18n-key="dateRangeLabel">Khoảng
                    thời gian duyệt</label>
                <div class="flex items-center gap-2">
                    <input id="date_from" type="date" name="date_from" value="{{ filters['date_from'] or '' }}"
                        class="w-full border border-slate-200 rounded-xl px-2.5 py-2 text-xs sm:text-sm outline-none bg-slate-50/50 focus:border-brand-500 focus:bg-white transition-all">
                    <span class="text-slate-400 font-medium shrink-0">—</span>
                    <input id="date_to" type="date" name="date_to" value="{{ filters['date_to'] or '' }}"
                        class="w-full border border-slate-200 rounded-xl px-2.5 py-2 text-xs sm:text-sm outline-none bg-slate-50/50 focus:border-brand-500 focus:bg-white transition-all">
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-3 border-t border-slate-100 pt-4">
            <a href="/documents/approved"
                class="px-5 py-2.5 border border-slate-200 text-slate-600 rounded-xl text-sm font-semibold hover:bg-slate-50 hover:text-slate-800 transition-colors flex items-center gap-1.5 shadow-sm">
                <i class="ti ti-refresh-dot text-base"></i> <span data-i18n-key="resetButton">Xóa bộ lọc</span>
            </a>
            <button type="submit"
                class="px-5 py-2.5 bg-brand-900 hover:bg-brand-800 text-white rounded-xl text-sm font-semibold transition-colors flex items-center gap-1.5 shadow-sm">
                <i class="ti ti-filter text-base"></i> <span data-i18n-key="filterButton">Lọc dữ liệu</span>
            </button>
        </div>
    </form>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap table-fixed">
                <thead
                    class="bg-slate-50 border-b border-slate-200 text-slate-700 uppercase font-bold text-[11px] tracking-wider">
                    <tr>
                        <th class="px-6 py-4 w-56" data-i18n-key="colId">ID</th>
                        <th class="px-6 py-4 w-auto" data-i18n-key="colFileName">Tên file</th>
                        <th class="px-6 py-4 w-36" data-i18n-key="colType">Loại</th>
                        <th class="px-6 py-4 w-40" data-i18n-key="colSubmittedBy">Người gửi</th>
                        <th class="px-6 py-4 w-48 text-center" data-i18n-key="colAction">Thao tác</th>
                    </tr>
                </thead>

                <tbody id="approvedDocumentsBody" class="divide-y divide-slate-100">
                    {% if documents %}
                    {% for document in documents %}
                    <tr class="hover:bg-slate-50/80 transition-colors group">
                        <td class="px-6 py-4 font-mono text-brand-500 font-semibold text-xs truncate max-w-[14rem]"
                            title="{{ document['document_code'] or document['id'] }}">
                            {{ document['document_code'] or document['id'] }}
                        </td>
                        <td class="px-6 py-4 font-medium text-slate-800 truncate"
                            title="{{ document['original_name'] }}">
                            {{ document['original_name'] }}
                        </td>
                        <td class="px-6 py-4">
                            <span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded-lg text-xs font-medium">{{
                                document['category'] }}</span>
                        </td>
                        <td class="px-6 py-4 text-slate-500 truncate" title="{{ document['submitted_by'] }}">
                            {{ document['submitted_by'] }}
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center justify-center gap-2">
                                <button type="button" data-id="{{ document['id'] }}"
                                    data-code="{{ document['document_code'] or document['id'] }}"
                                    data-name="{{ document['original_name'] }}"
                                    data-category="{{ document['category'] }}"
                                    data-submitter="{{ document['submitted_by'] }}"
                                    data-date="{{ document['reviewed_at'] or '' }}"
                                    data-reviewer="{{ document['reviewed_by'] or '' }}"
                                    data-location="{{ document['location'] or '' }}"
                                    data-desc="{{ document['description'] or '' }}" onclick="openDocumentModal(this)"
                                    class="text-slate-500 hover:text-brand-900 px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold flex items-center gap-1 shadow-sm transition-all shrink-0"
                                    title="Xem chi tiết">
                                    <i class="ti ti-eye"></i> <span data-i18n-key="detailBtn">Chi tiết</span>
                                </button>

                                <a href="/documents/{{ document['id'] }}/download" target="_blank" rel="noopener"
                                    class="text-slate-400 hover:text-brand-500 p-1.5 bg-white border border-slate-200 rounded-xl shadow-sm transition-colors shrink-0"
                                    title="Tải về">
                                    <i class="ti ti-download text-base"></i>
                                </a>

                                {% if user['role'] == 'MANAGER' %}
                                <form action="/documents/{{ document['id'] }}/delete" method="post"
                                    onsubmit="return confirm('Bạn có chắc muốn xóa hồ sơ này không?');"
                                    class="inline shrink-0">
                                    <button type="submit"
                                        class="text-slate-400 hover:text-rose-500 p-1.5 bg-white border border-slate-200 rounded-xl shadow-sm transition-colors"
                                        title="Xóa hồ sơ">
                                        <i class="ti ti-trash text-base"></i>
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                    {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400" data-i18n-key="emptyMessage">
                            Hiện chưa có hồ sơ nào được quản lý duyệt.
                        </td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="documentDetailsModal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 hidden backdrop-blur-sm opacity-0 transition-opacity duration-300"
    onclick="closeDocumentModal()">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 w-full max-w-lg transform scale-95 transition-transform duration-300 overflow-hidden"
        onclick="event.stopPropagation()">

        <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-800 flex items-center justify-center">
                    <i class="ti ti-file-info text-base"></i>
                </div>
                <h4 class="font-bold text-slate-800" data-i18n-key="modalTitle">Chi tiết hồ sơ lưu trữ</h4>
            </div>
            <button onclick="closeDocumentModal()"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 transition-colors">
                <i class="ti ti-x text-lg"></i>
            </button>
        </div>

        <div class="p-6 space-y-4 max-h-[70vh] overflow-y-auto">
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider" data-i18n-key="colId">ID /
                    Mã hồ sơ</span>
                <span id="modal_doc_code" class="col-span-2 text-sm font-mono font-bold text-brand-600"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="colFileName">Tên file gốc</span>
                <span id="modal_original_name" class="col-span-2 text-sm font-semibold text-slate-800 break-all"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider" data-i18n-key="colType">Loại
                    danh mục</span>
                <div><span id="modal_category"
                        class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded-md text-xs font-medium"></span></div>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="colSubmittedBy">Người gửi</span>
                <span id="modal_submitted_by" class="col-span-2 text-sm text-slate-700"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="colReviewedAt">Ngày phê duyệt</span>
                <span id="modal_reviewed_at" class="col-span-2 text-sm text-slate-700"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="colReviewedBy">Người phê duyệt</span>
                <span id="modal_reviewed_by" class="col-span-2 text-sm text-slate-700"></span>
            </div>
            <div class="grid grid-cols-3 gap-2 py-2 border-b border-slate-100">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                    data-i18n-key="colLocation">Vị trí lưu kho</span>
                <span id="modal_location" class="col-span-2 text-sm text-slate-700 font-medium"></span>
            </div>
            <div class="space-y-1.5 pt-1">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block"
