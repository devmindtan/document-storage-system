                    registerNow: "Đăng ký ngay"
                },

                en: {
                    pageTitle: "Document storage system login",
                    loginTitle: "DOCUMENT STORAGE SYSTEM",
                    loginSubtitle: "Log in to access the system.",
                    usernameLabel: "Username",
                    usernamePlaceholder: "Enter username",
                    passwordLabel: "Password",
                    passwordPlaceholder: "Enter password",
                    loginButton: "Log in",
                    noAccountText: "Don't have an account?",
                    registerNow: "Register now"
                }
            };

            function getLoginLanguage() {
                const savedLanguage = localStorage.getItem("appLanguage");

                if (savedLanguage === "en" || savedLanguage === "vi") {
                    return savedLanguage;
                }

                return "vi";
            }

            function saveLoginLanguage(language) {
                localStorage.setItem("appLanguage", language);
            }

            function setTextById(id, value) {
                const element = document.getElementById(id);

                if (element) {
                    element.textContent = value;
                }
            }

            function setPlaceholderById(id, value) {
                const element = document.getElementById(id);

                if (element) {
                    element.setAttribute("placeholder", value);
                }
            }

            function applyLoginLanguage(language) {
                const text = LOGIN_TEXT[language];
                const languageButton = document.getElementById("languageToggle");

                document.documentElement.lang = language;
                document.title = text.pageTitle;

                if (languageButton) {
                    languageButton.textContent = language === "vi" ? "EN" : "VI";
                }

                setTextById("loginTitle", text.loginTitle);
                setTextById("loginSubtitle", text.loginSubtitle);
                setTextById("usernameLabel", text.usernameLabel);
                setPlaceholderById("username", text.usernamePlaceholder);
                setTextById("passwordLabel", text.passwordLabel);
                setPlaceholderById("password", text.passwordPlaceholder);
                setTextById("loginButton", text.loginButton);
                setTextById("noAccountText", text.noAccountText);
                setTextById("registerNow", text.registerNow);

                saveLoginLanguage(language);
            }

            document.addEventListener("DOMContentLoaded", function () {
                applyLoginLanguage(getLoginLanguage());

                const languageButton = document.getElementById("languageToggle");

                if (languageButton) {
                    languageButton.onclick = function () {
                        const currentLanguage = getLoginLanguage();
                        const nextLanguage = currentLanguage === "vi" ? "en" : "vi";

                        applyLoginLanguage(nextLanguage);
                    };
                }
            });

            window.applyLoginLanguage = applyLoginLanguage;
        })();
    </script>
</body>
</html>
