                <a href="/manager/pending" class="border border-slate-200 text-slate-600 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors" data-i18n-key="resetButton">
                    Xóa lọc
                </a>
            </div>
        </form>
    </div>

    {% if documents %}
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap">
                    <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 uppercase font-semibold text-xs">
                        <tr>
                            <th class="px-6 py-4" data-i18n-key="tableId">ID</th>
                            <th class="px-6 py-4" data-i18n-key="fileName">Tên file</th>
                            <th class="px-6 py-4" data-i18n-key="project">Project</th>
                            <th class="px-6 py-4" data-i18n-key="type">Loại</th>
                            <th class="px-6 py-4" data-i18n-key="submittedBy">Người gửi</th>
                            <th class="px-6 py-4" data-i18n-key="submittedAt">Ngày gửi</th>
                            <th class="px-6 py-4" data-i18n-key="fileSize">Dung lượng</th>
                            <th class="px-6 py-4" data-i18n-key="action">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        {% for document in documents %}
                            <tr class="hover:bg-slate-50 transition-colors align-top">
                                <td class="px-6 py-4 font-mono text-brand-500 font-medium">{{ document['document_code'] or document['id'] }}</td>

                                <td class="px-6 py-4 font-medium text-slate-800">{{ document['original_name'] }}</td>

                                <td class="px-6 py-4">
                                    {{ document['project'] or 'Project 1' }}

                                    {% if document['requested_new_project'] %}
                                        <br>
                                        <span class="inline-block mt-1 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold" data-i18n-key="newProjectBadge">
                                            Project mới
                                        </span>
                                    {% endif %}
                                </td>

                                <td class="px-6 py-4">
                                    <span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md text-xs">{{ document['category'] }}</span>

                                    {% if document['requested_new_category'] %}
                                        <br>
                                        <span class="inline-block mt-1 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                                            <span data-i18n-key="newCategoryBadge">File con mới</span>
                                            {% if document['requested_category_code'] %}
                                                - {{ document['requested_category_code'] }}
                                            {% endif %}
                                        </span>
