                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="project_key" class="block text-sm font-medium text-slate-700"
                            data-i18n-key="projectLabel">Project</label>
                        <button type="button" onclick="openProjectModal('add')"
                            class="text-xs font-semibold text-brand-600 hover:text-brand-800 inline-flex items-center gap-1">
                            <i class="ti ti-plus"></i> <span data-i18n-key="addProjectBtn">Thêm project mới</span>
                        </button>
                    </div>

                    <select id="project_key" name="project_key" required
                        class="w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-sm text-slate-800 bg-white outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-colors">
                        {% for key, project in projects.items() %}
