            </p>
        {% endif %}
    </div>
    <script src="/static/language.js?v=700"></script>
<script>
(function () {
    const PAGE_TRANSLATIONS = {
        vi: {
            pageTitlePendingProjects: "Project chờ duyệt",
            pageTitleMyDocuments: "Hồ sơ của tôi",
            pendingProjectsTitle: "PROJECT CHỜ DUYỆT",
            myDocumentsTitle: "HỒ SƠ CỦA TÔI",
            managerLabel: "Quản lý:",
            employeeLabel: "Nhân viên:",
            backButton: "Quay lại",
            noPendingProjects: "Hiện chưa có project nào đang chờ duyệt.",
            noEmployeeDocuments: "Bạn chưa gửi hồ sơ nào.",
            tableId: "ID",
            projectName: "Tên project",
            requestedBy: "Người yêu cầu",
            requestedAt: "Ngày yêu cầu",
            action: "Thao tác",
            approve: "Duyệt",
            reject: "Từ chối",
            rejectionReason: "Lý do từ chối",
            fileName: "Tên file",
            type: "Loại",
            submittedAt: "Ngày gửi",
            status: "Trạng thái",
            approvedBy: "Người duyệt",
            statusPending: "Chờ quản lý duyệt",
            statusApproved: "Đã được duyệt",
            statusRejected: "Bị từ chối",
            statusUnknown: "Không xác định"
        },
        en: {
            pageTitlePendingProjects: "Pending projects",
            pageTitleMyDocuments: "My document",
            pendingProjectsTitle: "PENDING PROJECTS",
            myDocumentsTitle: "MY DOCUMENT",
            managerLabel: "Manager:",
            employeeLabel: "Employee:",
            backButton: "Back",
            noPendingProjects: "There are no pending projects.",
            noEmployeeDocuments: "You have not submitted any documents yet.",
            tableId: "ID",
            projectName: "Project name",
            requestedBy: "Requested by",
            requestedAt: "Requested at",
            action: "Action",
            approve: "Approve",
            reject: "Reject",
            rejectionReason: "Rejection reason",
            fileName: "File name",
            type: "Type",
            submittedAt: "Submitted at",
            status: "Status",
            approvedBy: "Approved by",
            statusPending: "Pending manager approval",
            statusApproved: "Approved",
            statusRejected: "Rejected",
            statusUnknown: "Unknown"
        }
    };

    function getCurrentLanguageSafe() {
        const savedLanguage = localStorage.getItem("appLanguage");

        if (savedLanguage === "en" || savedLanguage === "vi") {
            return savedLanguage;
        }

        return "vi";
    }

    function setPageLanguage(language) {
        const languageButton = document.getElementById("languageToggle");

        if (languageButton) {
            languageButton.textContent = language === "vi" ? "EN" : "VI";
        }

        document.documentElement.lang = language;

        const translations = PAGE_TRANSLATIONS[language] || PAGE_TRANSLATIONS.vi;

        document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
            const key = element.getAttribute("data-i18n-key");

            if (translations[key]) {
                element.textContent = translations[key];
            }
        });

        document.querySelectorAll("[data-i18n-placeholder-key]").forEach(function (element) {
            const key = element.getAttribute("data-i18n-placeholder-key");

            if (translations[key]) {
                element.setAttribute("placeholder", translations[key]);
            }
        });

        const pageTitleKey = document.body.getAttribute("data-page-title-key");

        if (pageTitleKey && translations[pageTitleKey]) {
            document.title = translations[pageTitleKey];
        }

        localStorage.setItem("appLanguage", language);
    }

    function patchGlobalApplyLanguage() {
        if (
            typeof window.applyLanguage === "function" &&
            !window.applyLanguage.__pageTranslationPatched
        ) {
            const originalApplyLanguage = window.applyLanguage;

            window.applyLanguage = function (language) {
                try {
                    originalApplyLanguage(language);
                } catch (error) {
                    console.warn("Global language.js error:", error);
                }

                setPageLanguage(language);
            };

            window.applyLanguage.__pageTranslationPatched = true;
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        patchGlobalApplyLanguage();

        setPageLanguage(getCurrentLanguageSafe());

        const languageButton = document.getElementById("languageToggle");

        if (languageButton && !languageButton.dataset.pageTranslationBound) {
            languageButton.dataset.pageTranslationBound = "1";

            languageButton.addEventListener("click", function (event) {
                event.preventDefault();
                event.stopImmediatePropagation();

                const currentLanguage = getCurrentLanguageSafe();
                const nextLanguage = currentLanguage === "vi" ? "en" : "vi";

                if (typeof window.applyLanguage === "function") {
                    try {
                        window.applyLanguage(nextLanguage);
                    } catch (error) {
                        console.warn("Global language.js error:", error);
                        setPageLanguage(nextLanguage);
                    }
                } else {
                    setPageLanguage(nextLanguage);
                }
            }, true);
        }
    });
})();
</script>
</body>
</html>
</file>

