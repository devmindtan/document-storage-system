{% block extra_script %}
<script>
    function openDocumentModal(btn) {
        const modal = document.getElementById('documentDetailsModal');
        const box = modal.querySelector('div');

        document.getElementById('modal_doc_code').textContent = btn.dataset.code || '-';
        document.getElementById('modal_original_name').textContent = btn.dataset.name || '-';
        document.getElementById('modal_category').textContent = btn.dataset.category || '-';
        document.getElementById('modal_submitted_by').textContent = btn.dataset.submitter || '-';
        document.getElementById('modal_reviewed_at').textContent = btn.dataset.date || '-';
        document.getElementById('modal_reviewed_by').textContent = btn.dataset.reviewer || '-';
        document.getElementById('modal_location').textContent = btn.dataset.location || '-';
        document.getElementById('modal_description').textContent = btn.dataset.desc || '-';
        document.getElementById('modal_download_btn').href = `/documents/${btn.dataset.id}/download`;

        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            box.classList.remove('scale-95');
        }, 10);
    }

    function closeDocumentModal() {
        const modal = document.getElementById('documentDetailsModal');
        const box = modal.querySelector('div');

        modal.classList.add('opacity-0');
        box.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchForm = document.getElementById("approvedSearchForm");
        const tableBody = document.getElementById("approvedDocumentsBody");

        if (!searchForm || !tableBody) return;

        let searchTimer = null;
        let activeController = null;

        function escapeHtml(value) {
            return String(value || "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function buildActionButtons(doc, isManager) {
            let html = `
            <div class="flex items-center justify-center gap-2">
                <button type="button" 
                    data-id="${escapeHtml(doc.id)}"
                    data-code="${escapeHtml(doc.document_code || doc.id)}"
                    data-name="${escapeHtml(doc.original_name)}"
                    data-category="${escapeHtml(doc.category)}"
                    data-submitter="${escapeHtml(doc.submitted_by)}"
                    data-date="${escapeHtml(doc.reviewed_at || '')}"
                    data-reviewer="${escapeHtml(doc.reviewed_by || '')}"
                    data-location="${escapeHtml(doc.location || '')}"
                    data-desc="${escapeHtml(doc.description || '')}"
                    onclick="openDocumentModal(this)"
                    class="text-slate-500 hover:text-brand-900 px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold flex items-center gap-1 shadow-sm transition-all shrink-0"
                    title="Xem chi tiết"
                >
                    <i class="ti ti-eye"></i> <span data-i18n-key="detailBtn">Chi tiết</span>
                </button>
                <a href="/documents/${doc.id}/download" target="_blank" rel="noopener" class="text-slate-400 hover:text-brand-500 p-1.5 bg-white border border-slate-200 rounded-xl shadow-sm transition-colors shrink-0" title="Tải về">
                    <i class="ti ti-download text-base"></i>
                </a>
        `;

            if (isManager) {
                html += `
                <form action="/documents/${doc.id}/delete" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa hồ sơ này không?');" class="inline shrink-0">
                    <button type="submit" class="text-slate-400 hover:text-rose-500 p-1.5 bg-white border border-slate-200 rounded-xl shadow-sm transition-colors" title="Xóa hồ sơ">
                        <i class="ti ti-trash text-base"></i>
                    </button>
                </form>
            `;
            }
            html += `</div>`;
            return html;
        }
        function renderDocuments(documents, isManager) {
            if (!documents || documents.length === 0) {
                tableBody.innerHTML = `
                <tr>
                    <td colspan="5" class="px-6 py-10 text-center text-slate-400" data-i18n-key="emptyMessage">Không tìm thấy tài liệu phù hợp.</td>
                </tr>
            `;
                return;
            }

            let html = "";
            documents.forEach(function (doc) {
                let docCode = escapeHtml(doc.document_code || doc.id || "-");
                let docName = escapeHtml(doc.original_name);
                let docCategory = escapeHtml(doc.category);
                let docSubmitter = escapeHtml(doc.submitted_by);

                html += `
                <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="px-6 py-4 font-mono text-brand-500 font-semibold text-xs truncate max-w-[14rem]" title="${docCode}">${docCode}</td>
                    <td class="px-6 py-4 font-medium text-slate-800 truncate" title="${docName}">${docName}</td>
                    <td class="px-6 py-4"><span class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded-lg text-xs font-medium">${docCategory}</span></td>
                    <td class="px-6 py-4 text-slate-500 truncate" title="${docSubmitter}">${docSubmitter}</td>
                    <td class="px-6 py-4">${buildActionButtons(doc, isManager)}</td>
                </tr>
            `;
            });

            tableBody.innerHTML = html;

            if (window.applyApprovedLanguage) {
                window.applyApprovedLanguage(localStorage.getItem("appLanguage") || "vi");
            }
        }

        function liveSearch() {
            const formData = new FormData(searchForm);
            const params = new URLSearchParams(formData);

            if (activeController) activeController.abort();
            activeController = new AbortController();

            tableBody.innerHTML = `
            <tr class="animate-pulse"><td colspan="5" class="px-6 py-4"><div class="h-4 bg-slate-100 rounded"></div></td></tr>
            <tr class="animate-pulse"><td colspan="5" class="px-6 py-4"><div class="h-4 bg-slate-100 rounded"></div></td></tr>
        `;

            fetch("/documents/approved/live-search?" + params.toString(), {
                method: "GET",
                headers: { "Accept": "application/json" },
                signal: activeController.signal
            })
                .then(res => {
                    if (!res.ok) throw new Error("Search request failed");
                    return res.json();
                })
                .then(data => {
                    renderDocuments(data.documents, data.is_manager);
                })
                .catch(err => {
                    if (err.name === "AbortError") return;
                    tableBody.innerHTML = `<tr><td colspan="5" class="px-6 py-10 text-center text-rose-500">Có lỗi khi tìm kiếm dữ liệu.</td></tr>`;
                });
        }

        function liveSearchWithDelay() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(liveSearch, 350);
        }

        searchForm.addEventListener("submit", function (e) {
            e.preventDefault();
            liveSearch();
        });

        searchForm.querySelectorAll("input, select").forEach(input => {
            if (input.tagName.toLowerCase() === "input") {
                input.addEventListener("input", liveSearchWithDelay);
            } else {
                input.addEventListener("change", liveSearch);
            }
        });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const projectSelect = document.getElementById("project");
        const categorySelect = document.getElementById("category");

        if (!projectSelect || !categorySelect) return;

        function updateApprovedCategoryOptions() {
            const selectedOption = projectSelect.options[projectSelect.selectedIndex];
            const projectId = selectedOption ? selectedOption.dataset.projectId : "";
            const selectedCategory = categorySelect.dataset.selectedCategory || categorySelect.value || "";

            if (!projectId) return;

            fetch("/project-categories/" + projectId)
                .then(res => res.json())
                .then(data => {
                    const allTypesText = localStorage.getItem("appLanguage") === "en" ? "All types" : "Tất cả loại";
                    categorySelect.innerHTML = '<option value="">' + allTypesText + '</option>';

                    if (!data.success || !data.categories) return;

                    data.categories.forEach(function (cat) {
                        const opt = document.createElement("option");
                        opt.value = cat.label;
                        opt.textContent = cat.label;
                        if (String(cat.label) === String(selectedCategory)) opt.selected = true;
                        categorySelect.appendChild(opt);
                    });
                    categorySelect.dataset.selectedCategory = categorySelect.value;
                });
        }

        projectSelect.addEventListener("change", function () {
            categorySelect.dataset.selectedCategory = "";
            updateApprovedCategoryOptions();
        });
        updateApprovedCategoryOptions();
    });
</script>

