                alt="Amata Engineering"
            >
        </a>
    </div>

    <button class="language-toggle" id="languageToggle" type="button">
        EN
    </button>
</div>
<div class="dashboard-box">
        <div class="top-bar">
            <div>
                <h1 data-i18n-key="myDocumentsTitle">HỒ SƠ CỦA TÔI</h1>
                <p>
                    <span data-i18n-key="employeeLabel">Nhân viên:</span>
                    <strong>{{ user['full_name'] }}</strong>
                </p>
            </div>

            <a class="logout-button" href="/employee" data-i18n-key="backButton">
                Quay lại
            </a>
        </div>

        <hr>

        {% if documents %}
            <table class="document-table">
                <thead>
                    <tr>
                        <th data-i18n-key="tableId">ID</th>
                        <th data-i18n-key="fileName">Tên file</th>
                        <th data-i18n-key="type">Loại</th>
                        <th data-i18n-key="submittedAt">Ngày gửi</th>
                        <th data-i18n-key="status">Trạng thái</th>
                        <th data-i18n-key="approvedBy">Người duyệt</th>
                        <th data-i18n-key="rejectionReason">Lý do từ chối</th>
                    </tr>
