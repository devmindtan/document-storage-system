<file path="templates/manager_upload.html">
{% extends "layout/base.html" %}

{% block title %}Quản lý upload hồ sơ{% endblock %}
{% block page_title %}<span data-i18n-key="pageHeading">QUẢN LÝ UPLOAD HỒ SƠ</span>{% endblock %}
{% block active_nav %}upload{% endblock %}
{% block extra_style %}
<style>
    .required-star {
        color: #e11d48;
        font-weight: bold;
        margin-left: 4px;
    }

    .custom-file-upload.is-dragover {
        background-color: #f0f5fa;
        border-color: #3b82f6;
    }

    /* ---- Button hierarchy ---- */
    .btn-primary {
        background: #0f172a;
        color: #fff;
        border-radius: 0.75rem;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .15);
        transition: background-color .15s ease;
    }

    .btn-primary:hover {
        background: #1e293b;
    }

    .btn-secondary {
        background: #fff;
        color: #334155;
        border: 1px solid #cbd5e1;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: background-color .15s ease;
    }

    .btn-secondary:hover {
        background: #f8fafc;
    }

    .btn-ghost {
        background: transparent;
        color: #475569;
        border-radius: 0.65rem;
        transition: background-color .15s ease;
    }

    .btn-ghost:hover {
        background: #f1f5f9;
    }

    .btn-danger {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: background-color .15s ease;
    }

    .btn-danger:hover {
        background: #fecaca;
    }

    /* ---- Workspace ---- */
    .workspace-sidebar-item.is-active {
        background: #eff6ff;
        border-color: #93c5fd;
    }

    .workspace-row:hover {
        background: #f8fafc;
    }

    .badge-count {
        background: #f1f5f9;
        color: #475569;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.1rem 0.5rem;
        border-radius: 9999px;
    }

    .spinner {
        width: 1rem;
        height: 1rem;
        border: 2px solid #cbd5e1;
        border-top-color: #0f172a;
        border-radius: 50%;
        animation: spin .6s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ================================================================
       FIX #1 — LỚP MODAL BỊ CẮT / LỆCH DO ANCESTOR CÓ transform/filter
       Ép z-index cao hơn hẳn mọi phần tử layout (sidebar, header...) và
       kèm theo JS bên dưới sẽ "teleport" các modal ra làm con trực tiếp
       của <body> để thoát khỏi containing block sai của bất kỳ ancestor
       nào có transform/filter/backdrop-filter.
       ================================================================ */
    #masterCatalogModal {
        z-index: 999;
    }

    #projectModal,
    #categoryModal {
        z-index: 1000;
    }

    #confirmDeleteModal {
        z-index: 1001;
    }

    /* Khi select đang chờ dữ liệu mới nhưng vẫn hiển thị dữ liệu cũ,
       làm mờ nhẹ để người dùng biết đang tải mà không bị "giật trắng" */
    .category-select-loading {
        opacity: 0.55;
        pointer-events: none;
    }

    /* Hiệu ứng mở mượt cho các modal (backdrop + panel), tự chạy lại mỗi
       lần bỏ class "hidden" vì CSS animation restart khi phần tử được
       hiển thị lại trong render tree — không cần sửa JS. */
    #masterCatalogModal:not(.hidden),
    #projectModal:not(.hidden),
    #categoryModal:not(.hidden),
    #confirmDeleteModal:not(.hidden) {
        animation: modalBackdropIn .18s ease-out;
    }

    #masterCatalogModal:not(.hidden) > div,
    #projectModal:not(.hidden) > div,
    #categoryModal:not(.hidden) > div,
    #confirmDeleteModal:not(.hidden) > div {
        animation: modalPanelIn .18s ease-out;
    }

    @keyframes modalBackdropIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes modalPanelIn {
        from { opacity: 0; transform: scale(0.96) translateY(8px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
</style>
{% endblock %}

{% block content %}
{% import "layout/_macros.html" as macros %}

<div class="dashboard-box max-w-5xl mx-auto space-y-6">
    <div class="top-bar flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-500">
            <span data-i18n-key="managerLabel">Quản lý:</span> <strong class="text-slate-800 font-semibold">{{ user['full_name'] }}</strong>
        </p>

        <a class="back-link inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-brand-600 transition-colors"
            href="/manager">
            <i class="ti ti-arrow-left"></i> <span data-i18n-key="backButton">Quay lại</span>
        </a>
    </div>

    {{ macros.banner('error', error) }}
    {{ macros.banner('success', success) }}

    <!-- ============ UPLOAD CARD (stepper style) ============ -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-200 bg-slate-50/50 flex flex-wrap items-center justify-between gap-4">
