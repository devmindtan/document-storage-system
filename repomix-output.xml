        }
    };

    function getLanguage() {
        return localStorage.getItem("appLanguage") || "vi";
    }

    function setLanguage(language) {
        localStorage.setItem("appLanguage", language);
    }

    function setTextByKey(key, value) {
        document.querySelectorAll('[data-i18n="' + key + '"]').forEach(function (element) {
            element.textContent = value;
        });
    }

    function applyDashboardLanguage(language) {
        const languageButton = document.getElementById("languageToggle");
        const text = TEXT[language] || TEXT.vi;

        document.documentElement.lang = language;

        if (languageButton) {
            languageButton.textContent = language === "vi" ? "EN" : "VI";
        }

        Object.keys(text).forEach(function (key) {
            setTextByKey(key, text[key]);
        });

        setLanguage(language);
    }

    document.addEventListener("DOMContentLoaded", function () {
        applyDashboardLanguage(getLanguage());

        const languageButton = document.getElementById("languageToggle");

        if (languageButton) {
            languageButton.onclick = function () {
                const nextLanguage = getLanguage() === "vi" ? "en" : "vi";
                applyDashboardLanguage(nextLanguage);
            };
        }
    });
})();
</script>

</body>
