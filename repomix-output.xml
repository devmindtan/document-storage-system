            </button>
        </div>

        <form action="/manager/upload" method="post" enctype="multipart/form-data" class="p-6 space-y-6">
            <!-- Step 1 -->
            <div class="rounded-xl border border-slate-200 p-5 space-y-4">
                <div class="flex items-center gap-2">
                    <span
                        class="w-6 h-6 rounded-full bg-brand-900 text-white text-xs font-bold flex items-center justify-center shrink-0">1</span>
