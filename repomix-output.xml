<file path="templates/manager_project_requests.html">
{% extends "layout/base.html" %}
{% import "layout/_macros.html" as macros %}

{% block title %}Project chờ duyệt{% endblock %}
{% block page_title %}<span data-i18n-key="pendingProjectsTitle">Project chờ duyệt</span>{% endblock %}
{% block active_nav %}project_requests{% endblock %}

{% block content %}
<div class="space-y-6">
    <p class="text-sm text-slate-500">
        <span data-i18n-key="managerLabel">Quản lý:</span>
        <span class="font-semibold text-slate-700">{{ user['full_name'] }}</span>
    </p>

    {{ macros.banner('success', message) }}
    {{ macros.banner('error', error) }}

    {% if project_requests %}
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap">
                    <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 uppercase font-semibold text-xs">
                        <tr>
                            <th class="px-6 py-4" data-i18n-key="tableId">ID</th>
                            <th class="px-6 py-4" data-i18n-key="projectName">Tên project</th>
                            <th class="px-6 py-4" data-i18n-key="requestedBy">Người yêu cầu</th>
                            <th class="px-6 py-4" data-i18n-key="requestedAt">Ngày yêu cầu</th>
                            <th class="px-6 py-4 text-right" data-i18n-key="action">Thao tác</th>
                        </tr>
                    </thead>

