{% block extra_script %}
<script>
    let projectModalMode = 'add';
    let categoryModalMode = 'add';
    let currentEditingKey = null;

    /* ================================================================
       FIX #1 (JS phần) — "Teleport" các modal ra làm con trực tiếp của
       <body>. Nếu layout/base.html có ancestor nào dùng transform/filter
       (ví dụ khi làm hiệu ứng slide sidebar mobile), containing block của
       position:fixed sẽ bị đổi theo ancestor đó thay vì viewport, khiến
       modal bị lệch/cắt như trong ảnh chụp. Đưa modal ra ngoài <body>
       đảm bảo modal luôn định vị theo toàn bộ viewport.
       ================================================================ */
    function portalModalsToBody() {
        ['masterCatalogModal', 'projectModal', 'categoryModal', 'confirmDeleteModal']
            .forEach(id => {
                const el = document.getElementById(id);
                if (el && el.parentElement !== document.body) {
                    document.body.appendChild(el);
                }
            });
    }

    /* showToast() is now shared globally via layout/base.html */

    function toggleSaveDisabled(inputId, btnId) {
        const val = document.getElementById(inputId).value.trim();
        document.getElementById(btnId).disabled = !val;
    }

    /* ---------------- Master catalog workspace ---------------- */
    function openMasterCatalogModal() {
        document.getElementById("projectSearchInput").value = "";
        document.getElementById("categorySearchInput").value = "";
        renderCatalogProjects();
        document.getElementById("masterCatalogModal").classList.remove("hidden");
    }

    function closeMasterCatalogModal() {
        document.getElementById("masterCatalogModal").classList.add("hidden");
    }

    function renderCatalogProjects() {
        const select = document.getElementById("project_key");
        const container = document.getElementById("catalogProjectList");
        const searchTerm = (document.getElementById("projectSearchInput").value || "").toLowerCase().trim();
        container.innerHTML = "";

        document.getElementById("statTotalProjects").textContent = select.options.length;

        const options = Array.from(select.options).filter(opt => opt.text.toLowerCase().includes(searchTerm));

        if (options.length === 0) {
            container.innerHTML = '<div class="p-4 text-center text-slate-400 text-xs">Không tìm thấy project nào</div>';
        } else {
            options.forEach(opt => {
                const isActive = opt.value === select.value;
                const div = document.createElement("div");
                div.className = `workspace-sidebar-item flex items-center justify-between px-3 py-2.5 cursor-pointer border-l-2 border-transparent hover:bg-slate-50 transition-colors ${isActive ? 'is-active border-l-2' : ''}`;
                div.innerHTML = `
                    <span class="text-sm font-semibold text-slate-700 truncate pr-2">${opt.text}</span>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button" class="p-1 rounded-md text-slate-400 hover:text-brand-600 hover:bg-brand-50" title="Sửa tên">
                            <i class="ti ti-edit text-sm"></i>
                        </button>
                        <button type="button" class="p-1 rounded-md text-slate-400 hover:text-rose-600 hover:bg-rose-50" title="Xóa">
                            <i class="ti ti-trash text-sm"></i>
                        </button>
                    </div>
                `;
                div.addEventListener("click", (e) => {
                    if (e.target.closest("button")) return;
                    select.value = opt.value;
                    select.dispatchEvent(new Event("change"));
                    renderCatalogProjects();
                });
                const [editBtn, delBtn] = div.querySelectorAll("button");
                editBtn.addEventListener("click", () => editCatalogProject(opt.value));
                delBtn.addEventListener("click", () => deleteCatalogProject(opt.value));
                container.appendChild(div);
            });
        }

        const activeOpt = select.options[select.selectedIndex];
        if (activeOpt) {
            document.getElementById("catalogActiveProjectName").textContent = activeOpt.text;
            document.getElementById("statActiveProject").textContent = activeOpt.text;
            renderCatalogCategoriesFiltered();
        } else {
            document.getElementById("catalogActiveProjectName").textContent = "--";
            document.getElementById("statActiveProject").textContent = "--";
        }
    }

    function renderCatalogCategoriesFiltered() {
        const catSelect = document.getElementById("category_key");
        const container = document.getElementById("catalogCategoryList");
        const searchTerm = (document.getElementById("categorySearchInput").value || "").toLowerCase().trim();
        container.innerHTML = "";

        const validOptions = Array.from(catSelect.options).filter(o => o.value);
        document.getElementById("statTotalCategories").textContent = validOptions.length;

        const filtered = validOptions.filter(opt => opt.textContent.toLowerCase().includes(searchTerm));

        if (!catSelect.options.length || !validOptions.length) {
            container.innerHTML = '<tr><td colspan="3" class="p-6 text-center text-slate-400 text-xs">Chưa có file con hoặc chưa chọn project</td></tr>';
            return;
        }

        if (filtered.length === 0) {
            container.innerHTML = '<tr><td colspan="3" class="p-6 text-center text-slate-400 text-xs">Không tìm thấy loại hồ sơ nào</td></tr>';
            return;
        }

        filtered.forEach(opt => {
            const name = opt.textContent.split(" - Mã:")[0];
            const code = opt.dataset.code || "--";
            const tr = document.createElement("tr");
            tr.className = "workspace-row transition-colors";
            tr.innerHTML = `
                <td class="px-4 py-2.5 text-slate-700 font-medium">${name}</td>
                <td class="px-4 py-2.5 text-slate-500">${code}</td>
                <td class="px-4 py-2.5 text-right">
                    <div class="inline-flex items-center gap-1">
                        <button type="button" class="btn-ghost p-1.5 text-emerald-600" title="Sửa"><i class="ti ti-edit text-sm"></i></button>
                        <button type="button" class="btn-ghost p-1.5 text-rose-600" title="Xóa"><i class="ti ti-trash text-sm"></i></button>
                    </div>
                </td>
            `;
            const [editBtn, delBtn] = tr.querySelectorAll("button");
            editBtn.addEventListener("click", () => editCatalogCategory(opt.value));
            delBtn.addEventListener("click", () => deleteCatalogCategory(opt.value));
            container.appendChild(tr);
        });
    }

    /* ---------------- Project quick actions ---------------- */
    function openProjectModal(mode) {
        projectModalMode = mode;
        const title = document.getElementById("projectModalTitle");
        const input = document.getElementById("projectInputName");
        const select = document.getElementById("project_key");

        if (mode === 'edit') {
            const selectedOpt = select.options[select.selectedIndex];
            if (!selectedOpt) return;
            title.textContent = "Sửa tên Project";
            input.value = selectedOpt.text;
            currentEditingKey = selectedOpt.value;
        } else {
            title.textContent = "Thêm Project mới";
            input.value = "";
        }
        toggleSaveDisabled('projectInputName', 'projectSaveBtn');
        document.getElementById("projectModal").classList.remove("hidden");
        input.focus();
    }

    function editCatalogProject(valKey) {
        const select = document.getElementById("project_key");
        select.value = valKey;
        openProjectModal('edit');
    }

    function closeProjectModal() {
        document.getElementById("projectModal").classList.add("hidden");
    }

    function submitProjectModal() {
        const input = document.getElementById("projectInputName");
        const val = input.value.trim();
        if (!val) return;

        const select = document.getElementById("project_key");
        if (projectModalMode === 'edit') {
            const opt = Array.from(select.options).find(o => o.value === currentEditingKey);
            if (opt) opt.text = val;
            showToast("Đã cập nhật project", "success");
        } else {
            const newKey = "proj_" + Date.now();
            const opt = document.createElement("option");
            opt.value = newKey;
            opt.textContent = val;
            opt.selected = true;
            select.appendChild(opt);
            select.dispatchEvent(new Event("change"));
            showToast("Đã thêm project mới", "success");
        }
        closeProjectModal();
        if (!document.getElementById("masterCatalogModal").classList.contains("hidden")) {
            renderCatalogProjects();
        }
    }

    function deleteCatalogProject(valKey) {
        const select = document.getElementById("project_key");
        const opt = Array.from(select.options).find(o => o.value === valKey);
        if (!opt) return;

        openConfirmDeleteModal(`Bạn có chắc muốn xóa project "${opt.text}"?`, () => {
            // FIX #2 phụ: xóa cache của project bị xóa để không còn dữ liệu rác
            delete categoryCache[valKey];

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/projects/${valKey}/delete`;
            document.body.appendChild(form);
            form.submit();
        });
    }

    /* ---------------- Category quick actions ---------------- */
    function openCategoryModal(mode) {
        categoryModalMode = mode;
        const title = document.getElementById("categoryModalTitle");
        const inputName = document.getElementById("categoryInputName");
        const inputCode = document.getElementById("categoryInputCode");
        const select = document.getElementById("category_key");

        if (mode === 'edit') {
            const selectedOpt = select.options[select.selectedIndex];
            if (!selectedOpt || !selectedOpt.value) return;
            title.textContent = "Sửa file con";
            inputName.value = selectedOpt.textContent.split(" - Mã:")[0];
            inputCode.value = selectedOpt.dataset.code || "";
            currentEditingKey = selectedOpt.value;
        } else {
            title.textContent = "Thêm file con mới";
            inputName.value = "";
            inputCode.value = "";
        }
        toggleSaveDisabled('categoryInputName', 'categorySaveBtn');
        document.getElementById("categoryModal").classList.remove("hidden");
        inputName.focus();
    }

    function editCatalogCategory(valKey) {
        const select = document.getElementById("category_key");
        select.value = valKey;
        openCategoryModal('edit');
    }

    function closeCategoryModal() {
        document.getElementById("categoryModal").classList.add("hidden");
    }

    function submitCategoryModal() {
        const inputName = document.getElementById("categoryInputName");
        const inputCode = document.getElementById("categoryInputCode");
        const nameVal = inputName.value.trim();
        if (!nameVal) return;

        const select = document.getElementById("category_key");
        const codeVal = inputCode.value.trim();

        if (categoryModalMode === 'edit') {
            const opt = Array.from(select.options).find(o => o.value === currentEditingKey);
            if (opt) {
                opt.textContent = codeVal ? `${nameVal} - Mã: ${codeVal}` : nameVal;
                opt.dataset.code = codeVal;
            }
            showToast("Đã cập nhật file con", "success");
        } else {
            const newCatKey = "cat_" + Date.now();
            const opt = document.createElement("option");
            opt.value = newCatKey;
            opt.textContent = codeVal ? `${nameVal} - Mã: ${codeVal}` : nameVal;
            opt.dataset.code = codeVal;
            opt.selected = true;
            select.appendChild(opt);
            showToast("Đã thêm file con mới", "success");
        }

        // FIX #2 phụ: dữ liệu category của project hiện tại vừa thay đổi,
        // xóa cache để lần load kế tiếp (hoặc khi mở lại catalog) lấy đúng dữ liệu mới
        delete categoryCache[projectSelectEl().value];

        closeCategoryModal();
        if (!document.getElementById("masterCatalogModal").classList.contains("hidden")) {
            renderCatalogCategoriesFiltered();
        }
    }

    function deleteCatalogCategory(valKey) {
        const select = document.getElementById("category_key");
        const opt = Array.from(select.options).find(o => o.value === valKey);
        if (!opt) return;

        openConfirmDeleteModal(`Bạn có chắc muốn xóa file con "${opt.textContent}"?`, () => {
            // FIX #2 phụ: xóa cache của project hiện tại
            delete categoryCache[projectSelectEl().value];

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/manager/project-categories/${valKey}/delete`;
            const projectKeyInput = document.createElement('input');
            projectKeyInput.type = 'hidden';
            projectKeyInput.name = 'project_key';
            projectKeyInput.value = projectSelectEl().value;
            form.appendChild(projectKeyInput);
            document.body.appendChild(form);
            form.submit();
        });
    }

    /* ---------------- Confirm delete modal ---------------- */
    function openConfirmDeleteModal(message, onConfirm) {
        document.getElementById("confirmDeleteMessage").textContent = message;
        const modal = document.getElementById("confirmDeleteModal");
        const btn = document.getElementById("confirmDeleteBtn");
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
        newBtn.addEventListener("click", () => {
            closeConfirmDeleteModal();
            onConfirm();
        });
        modal.classList.remove("hidden");
    }

    function closeConfirmDeleteModal() {
        document.getElementById("confirmDeleteModal").classList.add("hidden");
    }

    /* ================================================================
       FIX #2 — Cache dữ liệu category theo từng project + không xóa
       trắng <select> khi đang tải + hủy request cũ khi đổi project
       liên tục. Giúp việc chuyển project qua lại mượt hơn, không còn
       cảm giác "load load" liên tục mỗi lần đổi qua lại project cũ.
       ================================================================ */
    const categoryCache = {};          // projectId -> [{id, label, code}, ...]
    let categoryFetchController = null; // để hủy fetch cũ khi đổi project nhanh

    function projectSelectEl() {
        return document.getElementById("project_key");
    }

    /* ---------------- Page init ---------------- */
    document.addEventListener("DOMContentLoaded", function () {
        // Thoát khỏi mọi ancestor có transform/filter gây lệch modal
        portalModalsToBody();

        const projectSelect = document.getElementById("project_key");
        const categorySelect = document.getElementById("category_key");
        const fileInput = document.getElementById("uploaded_files");
        const selectedFileText = document.getElementById("selectedFileText");
        const spinner = document.getElementById("categoryLoadingSpinner");
        const uploadDropZone = document.querySelector(".custom-file-upload");
        const primaryUploadBtn = document.getElementById("primaryUploadBtn");
        const descriptionInput = document.getElementById("description");
        const locationInput = document.getElementById("location");

        function renderCategoryOptions(list) {
            categorySelect.innerHTML = "";
            if (!list || list.length === 0) {
                categorySelect.innerHTML = '<option value="">Không có file con nào</option>';
            } else {
                list.forEach(cat => {
                    const opt = document.createElement("option");
                    opt.value = cat.id;
                    opt.textContent = cat.code ? `${cat.label} - Mã: ${cat.code}` : cat.label;
                    opt.dataset.code = cat.code || "";
                    categorySelect.appendChild(opt);
                });
                categorySelect.selectedIndex = 0;
            }
            categorySelect.disabled = false;
            categorySelect.classList.remove("category-select-loading");
            spinner.classList.add("hidden");
            refreshCatalogCategoriesIfOpen();
            updateDocumentCodePreview();
        }

        function updateDocumentCodePreview() {
            const box = document.getElementById("codePreviewBox");
            const text = document.getElementById("codePreviewText");
            if (!box || !text) return;

            const projectId = projectSelect.value;
            const categoryKey = categorySelect.value;

            if (!projectId || !categoryKey) {
                box.classList.add("hidden");
                return;
            }

            fetch("/document-code-preview?project_id=" + encodeURIComponent(projectId) + "&category_key=" + encodeURIComponent(categoryKey), {
                method: "GET",
                headers: { "Accept": "application/json" }
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.preview_code) {
                        text.textContent = data.preview_code;
                        box.classList.remove("hidden");
                    } else {
                        box.classList.add("hidden");
                    }
                })
                .catch(() => box.classList.add("hidden"));
        }

        function loadCategories() {
            const projectId = projectSelect.value;

            if (!projectId) {
                categorySelect.innerHTML = '<option value="">Vui lòng chọn project trước...</option>';
                spinner.classList.add("hidden");
                categorySelect.classList.remove("category-select-loading");
                updateDocumentCodePreview();
                return;
            }

            // Đã có cache của project này -> hiển thị ngay, không loading, không giật
            if (categoryCache[projectId]) {
                renderCategoryOptions(categoryCache[projectId]);
                return;
            }

            // Hủy request trước đó nếu người dùng đổi project liên tục
            if (categoryFetchController) {
                categoryFetchController.abort();
            }
            categoryFetchController = new AbortController();

            // Chỉ làm mờ nhẹ + hiện spinner, KHÔNG xóa trắng nội dung <select> hiện tại
            categorySelect.classList.add("category-select-loading");
            categorySelect.disabled = true;
            spinner.classList.remove("hidden");

            fetch("/project-categories/" + projectId, {
                method: "GET",
                headers: { "Accept": "application/json" },
                signal: categoryFetchController.signal
            })
                .then(res => res.json())
                .then(data => {
                    const list = (data.success && data.categories) ? data.categories : [];
                    categoryCache[projectId] = list;
                    renderCategoryOptions(list);
                })
                .catch(err => {
                    if (err.name === "AbortError") return; // bị hủy do đổi sang project khác, bỏ qua
                    categorySelect.innerHTML = '<option value="">Không thể tải danh sách file con</option>';
                    categorySelect.disabled = false;
                    categorySelect.classList.remove("category-select-loading");
                    spinner.classList.add("hidden");
                    showToast("Không thể tải danh sách file con", "danger");
                    refreshCatalogCategoriesIfOpen();
                });
        }

        // Exposed so the catalog workspace can refresh itself once the async
        // category fetch triggered by a project switch has actually resolved.
        window.refreshCatalogCategoriesIfOpen = function () {
            const modal = document.getElementById("masterCatalogModal");
            if (modal && !modal.classList.contains("hidden")) {
                renderCatalogCategoriesFiltered();
            }
        };

        if (projectSelect) {
            projectSelect.addEventListener("change", loadCategories);
            loadCategories();
        }

        if (categorySelect) {
            categorySelect.addEventListener("change", updateDocumentCodePreview);
        }

        if (fileInput && selectedFileText) {
            fileInput.addEventListener("change", function () {
                const files = Array.from(fileInput.files);
                if (files.length === 0) {
                    selectedFileText.textContent = "Không có tệp nào được chọn";
                    return;
                }
                selectedFileText.textContent = files.length === 1 ? files[0].name : `Đã chọn ${files.length} tệp`;
            });
        }

        // Drag & drop visual feedback
        if (uploadDropZone && fileInput) {
            ["dragenter", "dragover"].forEach(evt => {
                uploadDropZone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    uploadDropZone.classList.add("is-dragover");
                });
            });
            ["dragleave", "drop"].forEach(evt => {
                uploadDropZone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    uploadDropZone.classList.remove("is-dragover");
                });
            });
            uploadDropZone.addEventListener("drop", (e) => {
                if (e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    fileInput.dispatchEvent(new Event("change"));
                }
            });
        }

        // Disable primary submit until required fields are filled
        function refreshSubmitState() {
            const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
            const hasDescription = descriptionInput.value.trim().length > 0;
            const hasLocation = locationInput.value.trim().length > 0;
            primaryUploadBtn.disabled = !(hasFile && hasDescription && hasLocation);
            primaryUploadBtn.classList.toggle("opacity-40", primaryUploadBtn.disabled);
            primaryUploadBtn.classList.toggle("cursor-not-allowed", primaryUploadBtn.disabled);
        }
        [fileInput, descriptionInput, locationInput].forEach(el => {
            if (el) el.addEventListener("input", refreshSubmitState);
        });
        refreshSubmitState();
    });

    // ============================================================
    // PAGE-SPECIFIC TRANSLATION FIX
    // Manager Upload page
    // ============================================================

    (function () {
        const PAGE_TRANSLATIONS = {
            vi: {
                pageHeading: "QUẢN LÝ UPLOAD HỒ SƠ",
                managerLabel: "Quản lý:",
                backButton: "Quay lại",
                cardTitle: "Upload hồ sơ",
                cardSubtitle: "Hồ sơ do quản lý upload sẽ được đưa thẳng vào kho chính thức.",
                manageCatalogBtn: "Quản lý danh mục",
                step1Heading: "Chọn vị trí lưu trữ",
                projectLabel: "Project",
                addProjectBtn: "Thêm project mới",
                categoryLabel: "Loại hồ sơ (File con)",
                addCategoryBtn: "Thêm loại hồ sơ mới",
                codePreviewLabel: "Mã hồ sơ dự kiến:",
                codePreviewNote: "(có thể thay đổi tại thời điểm tải lên)",
                step2Heading: "Chọn tệp",
                dragDropText: "Kéo thả tệp vào đây, hoặc bấm để chọn",
                supportedFormats: "Hỗ trợ nhiều tệp • PDF, DOCX, XLSX, JPG",
                chooseFileBtn: "Chọn tệp",
                noFileSelected: "Không có tệp nào được chọn",
                step3Heading: "Thông tin mô tả",
                descriptionLabel: "Mô tả",
                requiredNote: "Bắt buộc nhập. Tối đa 50 ký tự.",
                locationLabel: "Vị trí",
                submitBtn: "Upload và duyệt ngay",
                catalogModalTitle: "Quản lý kho Project & Danh mục",
                catalogModalSubtitle: "Tìm kiếm, thêm, sửa, xóa project và loại hồ sơ.",
                totalProjectsLabel: "Tổng project",
                totalCategoriesLabel: "Loại hồ sơ (project đang chọn)",
                activeProjectLabel: "Project đang chọn",
                projectsHeading: "Projects",
                addBtn: "Thêm",
                categoriesOfLabel: "Loại hồ sơ của:",
                addCategoryModalBtn: "Thêm loại hồ sơ",
                categoryNameHeader: "Tên loại hồ sơ",
                codeHeader: "Mã",
                actionHeader: "Thao tác",
                closeBtn: "Đóng",
                projectNameFieldLabel: "Tên Project",
                cancelBtn: "Hủy",
                saveBtn: "Lưu lại",
                categoryNameFieldLabel: "Tên file con",
                categoryCodeFieldLabel: "Mã file con (Tùy chọn)",
                confirmDeleteTitle: "Xác nhận xóa",
                deleteConfirmBtn: "Xóa"
            },
            en: {
                pageHeading: "MANAGER DOCUMENT UPLOAD",
                managerLabel: "Manager:",
                backButton: "Back",
                cardTitle: "Upload document",
                cardSubtitle: "Documents uploaded by a manager go straight into the official archive.",
                manageCatalogBtn: "Manage catalog",
                step1Heading: "Select storage location",
                projectLabel: "Project",
                addProjectBtn: "Add new project",
                categoryLabel: "Document type (sub-file)",
                addCategoryBtn: "Add new document type",
                codePreviewLabel: "Expected document code:",
                codePreviewNote: "(may change at the time of upload)",
                step2Heading: "Select file",
                dragDropText: "Drag and drop a file here, or click to select",
                supportedFormats: "Supports multiple files • PDF, DOCX, XLSX, JPG",
                chooseFileBtn: "Choose file",
                noFileSelected: "No file selected",
                step3Heading: "Description details",
                descriptionLabel: "Description",
                requiredNote: "Required. Maximum 50 characters.",
                locationLabel: "Location",
                submitBtn: "Upload and approve now",
                catalogModalTitle: "Manage Project & Category catalog",
                catalogModalSubtitle: "Search, add, edit, and delete projects and document types.",
                totalProjectsLabel: "Total projects",
                totalCategoriesLabel: "Document types (selected project)",
                activeProjectLabel: "Selected project",
                projectsHeading: "Projects",
                addBtn: "Add",
                categoriesOfLabel: "Document types of:",
                addCategoryModalBtn: "Add document type",
                categoryNameHeader: "Document type name",
                codeHeader: "Code",
                actionHeader: "Action",
                closeBtn: "Close",
                projectNameFieldLabel: "Project name",
                cancelBtn: "Cancel",
                saveBtn: "Save",
                categoryNameFieldLabel: "Sub-file name",
                categoryCodeFieldLabel: "Sub-file code (optional)",
                confirmDeleteTitle: "Confirm deletion",
                deleteConfirmBtn: "Delete"
            }
        };

        function getPageLanguage() {
            const savedLanguage = localStorage.getItem("appLanguage");
            if (savedLanguage === "en" || savedLanguage === "vi") {
                return savedLanguage;
            }
            return "vi";
        }

        function applyPageTranslations() {
            const currentLanguage = getPageLanguage();

            document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-key");

                if (
                    PAGE_TRANSLATIONS[currentLanguage] &&
                    PAGE_TRANSLATIONS[currentLanguage][key]
                ) {
                    element.textContent = PAGE_TRANSLATIONS[currentLanguage][key];
                }
            });
        }

        window.applyPageTranslationsFunc = applyPageTranslations;

        document.addEventListener("DOMContentLoaded", function () {
            setTimeout(applyPageTranslations, 50);

            const languageButton = document.getElementById("languageToggle");

            if (languageButton) {
                languageButton.addEventListener("click", function () {
                    setTimeout(applyPageTranslations, 100);
                });
            }
        });

        window.addEventListener("load", function () {
            setTimeout(applyPageTranslations, 50);
        });
    })();
</script>
