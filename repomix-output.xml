                <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                    <span data-i18n-key="createManagerDescBefore">Tài khoản được tạo sẽ tự động được gán quyền</span>
                    <span class="font-semibold text-emerald-700">MANAGER</span><span
                        data-i18n-key="createManagerDescAfter">, có khả năng phê duyệt hồ sơ và quản lý tài
                        liệu của nhân viên.</span>
                </p>
            </div>
        </div>

        <form action="/admin/create-manager" method="post" class="p-6 sm:p-8 space-y-6"
            onsubmit="return confirm('⚠️ Chú ý: Bạn đang cấp quyền QUẢN LÝ (MANAGER) cho tài khoản này. Họ sẽ có quyền truy cập vào dữ liệu nhạy cảm. Bạn có chắc chắn muốn tiếp tục?');">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label for="username"
                        class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2"><span
                            data-i18n-key="usernameLabel">Tên đăng nhập</span> <span
                            class="text-rose-500">*</span></label>
                    <div class="relative group">
                        <i
                            class="ti ti-id absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg group-focus-within:text-emerald-600 transition-colors"></i>
                        <input id="username" type="text" name="username" placeholder="VD: nguyen.van.a"
                            data-i18n-placeholder="usernamePlaceholder" required
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-200 rounded-xl text-sm outline-none focus:bg-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all">
                    </div>
                </div>

                <div>
                    <label for="full_name"
                        class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2"><span
                            data-i18n-key="fullNameLabel">Họ và tên</span> <span class="text-rose-500">*</span></label>
                    <div class="relative group">
                        <i
                            class="ti ti-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg group-focus-within:text-emerald-600 transition-colors"></i>
                        <input id="full_name" type="text" name="full_name" placeholder="VD: Nguyễn Văn A"
                            data-i18n-placeholder="fullNamePlaceholder" required
                            class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-200 rounded-xl text-sm outline-none focus:bg-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all">
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label for="password"
                        class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2"><span
                            data-i18n-key="passwordLabel">Mật khẩu</span> <span class="text-rose-500">*</span></label>
                    <div class="relative group">
                        <i
                            class="ti ti-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg group-focus-within:text-emerald-600 transition-colors"></i>
                        <input id="password" type="password" name="password" placeholder="Tối thiểu 8 ký tự"
                            data-i18n-placeholder="passwordPlaceholder" required
                            class="w-full pl-10 pr-10 py-2.5 bg-slate-50/50 border border-slate-200 rounded-xl text-sm outline-none focus:bg-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all">
                        <button type="button" onclick="togglePassword('password', this)"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-600 focus:outline-none">
                            <i class="ti ti-eye text-lg"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="confirm_password"
                        class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2"><span
                            data-i18n-key="confirmPasswordLabel">Xác nhận mật khẩu</span>
                        <span class="text-rose-500">*</span></label>
                    <div class="relative group">
                        <i
                            class="ti ti-lock-check absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-lg group-focus-within:text-emerald-600 transition-colors"></i>
                        <input id="confirm_password" type="password" name="confirm_password"
                            placeholder="Nhập lại mật khẩu" data-i18n-placeholder="confirmPasswordPlaceholder" required
                            class="w-full pl-10 pr-10 py-2.5 bg-slate-50/50 border border-slate-200 rounded-xl text-sm outline-none focus:bg-white focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 transition-all">
                        <button type="button" onclick="togglePassword('confirm_password', this)"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-emerald-600 focus:outline-none">
                            <i class="ti ti-eye text-lg"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="bg-emerald-50/50 border border-emerald-200 rounded-xl p-4 flex gap-3 mt-2">
                <i class="ti ti-shield-lock text-emerald-600 text-xl shrink-0"></i>
                <p class="text-sm text-emerald-800 leading-relaxed" data-i18n-key="infoBoxText">
                    Vui lòng cung cấp tài khoản này cho người quản lý nội bộ. Họ có thể thay đổi mật khẩu sau khi đăng
                    nhập lần đầu tiên.
                </p>
            </div>

            <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-end gap-3">
                <a href="/manager/users"
                    class="px-5 py-2.5 text-sm font-semibold text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-colors"
                    data-i18n-key="cancelBtn">
                    Hủy bỏ
                </a>
                <button type="submit"
                    class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl text-sm font-semibold shadow-sm inline-flex items-center gap-2 transition-transform active:scale-95">
                    <i class="ti ti-shield-check text-base"></i> <span data-i18n-key="submitBtn">Cấp quyền tài
                        khoản</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block extra_script %}
<script>
    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('ti-eye');
            icon.classList.add('ti-eye-off');
            icon.classList.add('text-emerald-600');
        } else {
            input.type = 'password';
            icon.classList.remove('ti-eye-off');
            icon.classList.add('ti-eye');
            icon.classList.remove('text-emerald-600');
        }
    }

    (function () {
        const PAGE_TRANSLATIONS = {
            vi: {
                createManagerHeader: "Cấp quyền Quản lý hệ thống",
                createManagerDescBefore: "Tài khoản được tạo sẽ tự động được gán quyền",
                createManagerDescAfter: ", có khả năng phê duyệt hồ sơ và quản lý tài liệu của nhân viên.",
                usernameLabel: "Tên đăng nhập",
                usernamePlaceholder: "VD: nguyen.van.a",
                fullNameLabel: "Họ và tên",
                fullNamePlaceholder: "VD: Nguyễn Văn A",
                passwordLabel: "Mật khẩu",
                passwordPlaceholder: "Tối thiểu 8 ký tự",
                confirmPasswordLabel: "Xác nhận mật khẩu",
                confirmPasswordPlaceholder: "Nhập lại mật khẩu",
                infoBoxText: "Vui lòng cung cấp tài khoản này cho người quản lý nội bộ. Họ có thể thay đổi mật khẩu sau khi đăng nhập lần đầu tiên.",
                cancelBtn: "Hủy bỏ",
                submitBtn: "Cấp quyền tài khoản"
            },
            en: {
                createManagerHeader: "Grant System Manager Access",
                createManagerDescBefore: "The created account will automatically be assigned the",
                createManagerDescAfter: "role, able to approve documents and manage staff files.",
                usernameLabel: "Username",
                usernamePlaceholder: "e.g. nguyen.van.a",
                fullNameLabel: "Full name",
                fullNamePlaceholder: "e.g. Nguyen Van A",
                passwordLabel: "Password",
                passwordPlaceholder: "At least 8 characters",
                confirmPasswordLabel: "Confirm password",
                confirmPasswordPlaceholder: "Re-enter password",
                infoBoxText: "Please provide this account to the internal manager. They can change the password after their first login.",
                cancelBtn: "Cancel",
                submitBtn: "Grant Access"
            }
        };

        function getPageLanguage() {
            const savedLanguage = localStorage.getItem("appLanguage");
            return (savedLanguage === "en" || savedLanguage === "vi") ? savedLanguage : "vi";
        }

        function applyPageTranslations() {
            const currentLanguage = getPageLanguage();
            const dict = PAGE_TRANSLATIONS[currentLanguage];

            document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-key");
                if (dict && dict[key]) {
                    element.textContent = dict[key];
                }
            });

            document.querySelectorAll("[data-i18n-placeholder]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-placeholder");
                if (dict && dict[key]) {
                    element.setAttribute("placeholder", dict[key]);
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            applyPageTranslations();

            const languageButton = document.getElementById("languageToggle");
            if (languageButton) {
                languageButton.addEventListener("click", function () {
                    setTimeout(applyPageTranslations, 100);
                });
            }
        });
    })();
</script>
{% endblock %}
</file>

<file path="templates/manager_users.html">
{% extends "layout/base.html" %}

{% block title %}Quản lý tài khoản{% endblock %}
{% block page_title %}
<span id="pageTitleText" data-i18n-key="pageTitleApproval">Duyệt tài khoản</span>
{% endblock %}
{% block active_nav %}manager_users{% endblock %}

{% block content %}
<div class="space-y-6 relative">

    <div id="mainView" class="space-y-6">
        {% if users %}
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap">
                    <thead class="bg-slate-50 border-b border-slate-200 text-slate-700 uppercase font-semibold text-xs">
                        <tr>
                            <th class="px-6 py-4" data-i18n-key="userNameHeader">Tên người dùng</th>
                            <th class="px-6 py-4" data-i18n-key="accountHeader">Tài khoản</th>
                            <th class="px-6 py-4" data-i18n-key="roleHeader">Phân quyền</th>
                            <th class="px-6 py-4" data-i18n-key="createdAtHeader">Ngày tạo</th>
                            <th class="px-6 py-4" data-i18n-key="statusHeader">Trạng thái</th>
                            <th class="px-6 py-4 text-right" data-i18n-key="actionHeader">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for u in users %}
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-800">{{ u.full_name }}</td>
                            <td class="px-6 py-4">{{ u.username }}</td>
                            <td class="px-6 py-4">
                                {% if u.is_admin %}
                                <span
                                    class="bg-purple-100 text-purple-700 px-2.5 py-1 rounded text-xs font-bold">ADMIN</span>
                                {% elif u.role == 'MANAGER' %}
                                <span
                                    class="bg-blue-100 text-blue-700 px-2.5 py-1 rounded text-xs font-bold">MANAGER</span>
                                {% else %}
                                <span
                                    class="bg-slate-100 text-slate-600 px-2.5 py-1 rounded text-xs font-bold">EMPLOYEE</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">{{ u.created_at }}</td>
                            <td class="px-6 py-4">
                                {% if u.approval_status == 'PENDING' %}
                                <span class="flex items-center gap-1.5 text-amber-600 text-xs font-medium"><span
                                        class="w-2 h-2 rounded-full bg-amber-500"></span> <span
                                        data-i18n-key="pendingStatus">Chờ duyệt</span></span>
                                {% elif u.approval_status == 'REJECTED' %}
                                <span class="flex items-center gap-1.5 text-rose-600 text-xs font-medium"><span
                                        class="w-2 h-2 rounded-full bg-rose-500"></span> <span
                                        data-i18n-key="rejectedStatus">Đã từ chối</span></span>
                                {% elif u.is_active %}
                                <span class="flex items-center gap-1.5 text-emerald-600 text-xs font-medium"><span
                                        class="w-2 h-2 rounded-full bg-emerald-500"></span> <span
                                        data-i18n-key="activeStatus">Đang hoạt động</span></span>
                                {% else %}
                                <span class="flex items-center gap-1.5 text-slate-400 text-xs font-medium"><span
                                        class="w-2 h-2 rounded-full bg-slate-300"></span> <span
                                        data-i18n-key="lockedStatus">Đã khóa</span></span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-right">
                                {% if u.id == user.id %}
                                <span class="text-xs text-slate-400 italic" data-i18n-key="currentAccount">Tài khoản
                                    hiện tại</span>
                                {% elif u.is_admin %}
                                <span class="text-xs text-slate-400 italic" data-i18n-key="adminText">Admin</span>
                                {% elif u.approval_status == 'PENDING' %}
                                <div class="flex items-center justify-end gap-2">
                                    <form method="post" action="/manager/users/{{ u.id }}/approve">
                                        <button type="submit"
                                            class="px-3 py-1.5 bg-emerald-100 text-emerald-700 hover:bg-emerald-200 rounded text-xs font-semibold inline-flex items-center gap-1 transition-colors">
                                            <i class="ti ti-check"></i> <span data-i18n-key="approveButton">Duyệt tài
                                                khoản</span>
                                        </button>
                                    </form>
                                    <form method="post" action="/manager/users/{{ u.id }}/reject">
                                        <button type="submit"
                                            class="px-3 py-1.5 bg-rose-100 text-rose-700 hover:bg-rose-200 rounded text-xs font-semibold inline-flex items-center gap-1 transition-colors">
                                            <i class="ti ti-x"></i> <span data-i18n-key="rejectButton">Từ chối</span>
                                        </button>
                                    </form>
                                </div>
                                {% else %}
                                <div class="flex items-center justify-end gap-2">
                                    {% if u.role == 'EMPLOYEE' %}
                                    <button type="button"
                                        onclick="openPermissionsView('{{ u.id }}', '{{ u.full_name|e }}', '{{ u.username|e }}')"
                                        class="text-slate-500 hover:text-blue-600 p-1.5 bg-white border border-slate-200 hover:border-blue-200 rounded shadow-sm inline-flex transition-all duration-200"
                                        data-i18n-title="permissionsTitle" title="Phân quyền">
                                        <i class="ti ti-shield-check text-lg"></i>
                                    </button>
                                    {% endif %}
                                    <form id="form-toggle-status-{{ u.id }}" method="post"
                                        action="/manager/users/{{ u.id }}/toggle-status" class="inline-block">
                                        {% if u.is_active %}
                                        <button type="button"
                                            onclick="openConfirmModal('form-toggle-status-{{ u.id }}', 'Khóa tài khoản', 'Bạn có chắc chắn muốn khóa tài khoản {{ u.full_name|e }}? Người dùng này sẽ không thể đăng nhập vào hệ thống nữa.')"
                                            class="text-slate-400 hover:text-rose-500 p-1.5 bg-white border border-slate-200 hover:border-rose-200 rounded shadow-sm transition-all duration-200"
                                            data-i18n-title="lockTitle" title="Khóa tài khoản">
                                            <i class="ti ti-lock text-lg"></i>
                                        </button>
                                        {% else %}
                                        <button type="button"
                                            onclick="openConfirmModal('form-toggle-status-{{ u.id }}', 'Mở khóa tài khoản', 'Bạn có muốn mở khóa cho tài khoản {{ u.full_name|e }} để họ có thể tiếp tục sử dụng hệ thống?')"
                                            class="text-slate-400 hover:text-emerald-500 p-1.5 bg-white border border-slate-200 hover:border-emerald-200 rounded shadow-sm transition-all duration-200"
                                            data-i18n-title="unlockTitle" title="Mở khóa">
                                            <i class="ti ti-lock-open text-lg"></i>
                                        </button>
                                        {% endif %}
                                    </form>
                                    {% if u.role == 'EMPLOYEE' %}
                                    <form id="form-promote-{{ u.id }}" method="post"
                                        action="/manager/users/{{ u.id }}/promote-manager" class="inline-block">
                                        <button type="button"
                                            onclick="openConfirmModal('form-promote-{{ u.id }}', 'Thăng chức quản lý', 'Bạn có chắc muốn cấp quyền Quản lý (Manager) cho tài khoản {{ u.full_name|e }}?')"
                                            class="text-emerald-600 hover:text-emerald-700 p-1.5 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 rounded shadow-sm transition-all duration-200"
                                            title="Thăng chức Quản lý">
                                            <i class="ti ti-user-up text-lg"></i>
                                        </button>
                                    </form>
                                    {% else %}
                                    <form id="form-demote-{{ u.id }}" method="post"
                                        action="/manager/users/{{ u.id }}/demote-employee" class="inline-block">
                                        <button type="button"
                                            onclick="openConfirmModal('form-demote-{{ u.id }}', 'Giáng chức nhân viên', 'Bạn có chắc muốn rút quyền Quản lý của tài khoản {{ u.full_name|e }} và chuyển về Nhân viên?')"
                                            class="text-amber-600 hover:text-amber-700 p-1.5 bg-amber-50 border border-amber-200 hover:bg-amber-100 rounded shadow-sm transition-all duration-200"
                                            title="Giáng chức Nhân viên">
                                            <i class="ti ti-user-down text-lg"></i>
                                        </button>
                                    </form>
                                    {% endif %}
                                </div>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% else %}
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-sm text-slate-500 text-center">
            <span data-i18n-key="noAccounts">Chưa có tài khoản nào trong hệ thống.</span>
        </div>
        {% endif %}
    </div>

    <div id="permissionsView"
        class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm p-6 fade-in animate-duration-200">

        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-5 mb-6">
            <div class="flex items-center gap-3">
                <button type="button" onclick="closePermissionsView()"
                    class="group flex items-center gap-2 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition-all duration-200">
                    <i class="ti ti-arrow-left text-base transition-transform group-hover:-translate-x-0.5"></i>
                    <span data-i18n-key="backButton">Quay lại danh sách</span>
                </button>
                <div class="h-5 w-[1px] bg-slate-200 hidden sm:block"></div>
                <div>
                    <h3 class="text-base font-bold text-slate-800 flex items-center gap-1.5">
                        <span data-i18n-key="permissionFor">Phân quyền cho:</span>
                        <span id="targetUserRealName" class="text-blue-600 font-extrabold">...</span>
                    </h3>
                    <p class="text-xs text-slate-400 font-mono mt-0.5">@<span id="targetUsername">username</span></p>
                </div>
            </div>
        </div>

        <form id="permissionsForm" method="post" action="" class="space-y-6">
            <label class="flex items-center gap-3 p-3 rounded-lg border border-amber-200 bg-amber-50/60 cursor-pointer">
                <input type="checkbox" id="permissionsEnabledInput" name="enabled" value="1"
                    class="w-4 h-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500"
                    onchange="togglePermissionsCheckboxes(this)">
                <span class="text-sm font-semibold text-slate-800" data-i18n-key="enableToggleLabel">Bật giới hạn phân
                    quyền cho tài khoản này</span>
            </label>

            <div class="p-5 border border-slate-100 rounded-xl bg-slate-50/50 space-y-3">
                <h4 class="text-sm font-bold text-slate-700 flex items-center gap-2">
                    <i class="ti ti-folder text-blue-500 text-base"></i>
                    <span data-i18n-key="permissionsSectionTitle">Loại hồ sơ được phép upload</span>
                </h4>
                <hr class="border-slate-200/60">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="permissionsCategoryList">
                    {% for key, category in categories.items() %}
                    <label
                        class="flex items-center gap-3 cursor-pointer p-2 rounded hover:bg-white transition-colors group">
                        <input type="checkbox" name="categories" value="{{ category.label }}"
                            class="permission-checkbox rounded border-slate-300 text-blue-600 focus:ring-blue-500 disabled:bg-slate-100 disabled:cursor-not-allowed">
                        <span class="text-sm font-medium text-slate-700 group-hover:text-slate-900">
                            {{ category.label }}
                        </span>
                    </label>
                    {% endfor %}
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closePermissionsView()"
                    class="px-5 py-2 border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-xl text-sm font-medium transition-colors"
                    data-i18n-key="cancelButton">
                    Hủy bỏ
                </button>

                <button type="submit" style="background-color: #2563eb;"
                    class="px-6 py-2 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-all duration-200 flex items-center gap-2 cursor-pointer appearance-none border-0">
                    <i class="ti ti-device-floppy text-base text-white"></i>
                    <span data-i18n-key="savePermissionsButton">Lưu cấu hình</span>
                </button>
            </div>
        </form>
    </div>
    <div id="customConfirmModal"
        class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-900/50 backdrop-blur-sm transition-opacity opacity-0">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6 transform scale-95 transition-transform duration-200"
            id="customConfirmModalContent">
            <div class="flex items-center gap-4 mb-4">
                <div
                    class="w-10 h-10 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
                    <i class="ti ti-alert-triangle text-xl"></i>
                </div>
                <h3 id="confirmModalTitle" class="text-lg font-bold text-slate-800">Xác nhận thao tác</h3>
            </div>

            <p id="confirmModalMessage" class="text-sm text-slate-600 mb-6 ml-14">
                Bạn có chắc chắn muốn thực hiện hành động này không?
            </p>

            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeConfirmModal()"
                    class="px-4 py-2 border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-xl text-sm font-medium transition-colors">
                    Hủy bỏ
                </button>
                <button type="button" id="confirmModalBtn"
                    class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">
                    Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<script id="permissionsDataJson" type="application/json">{{ permissions_by_user_json | safe }}</script>
<script>
    (function () {
        const PAGE_TRANSLATIONS = {
            vi: {
                pageTitleApproval: "Duyệt tài khoản",
                pageTitlePermission: "Cấu hình phân quyền",
                userNameHeader: "Tên người dùng",
                accountHeader: "Tài khoản",
                roleHeader: "Phân quyền",
                createdAtHeader: "Ngày tạo",
                statusHeader: "Trạng thái",
                actionHeader: "Thao tác",
                pendingStatus: "Chờ duyệt",
                rejectedStatus: "Đã từ chối",
                activeStatus: "Đang hoạt động",
                lockedStatus: "Đã khóa",
                currentAccount: "Tài khoản hiện tại",
                adminText: "Admin",
                approveButton: "Duyệt tài khoản",
                rejectButton: "Từ chối",
                permissionsTitle: "Phân quyền",
                lockTitle: "Khóa tài khoản",
                unlockTitle: "Mở khóa",
                promoteButton: "Thăng chức",
                promoteTitle: "Chuyển thành quản lý",
                demoteButton: "Giáng chức",
                demoteTitle: "Chuyển về nhân viên",
                noAccounts: "Chưa có tài khoản nào trong hệ thống.",
                backButton: "Quay lại danh sách",
                permissionFor: "Phân quyền cho:",
                cancelButton: "Hủy bỏ",
                savePermissionsButton: "Lưu cấu hình",
                enableToggleLabel: "Bật giới hạn phân quyền cho tài khoản này",
                permissionsSectionTitle: "Loại hồ sơ được phép upload"
            },
            en: {
                // ... (phần tiếng anh giữ nguyên)
                pageTitleApproval: "Account Approval",
                pageTitlePermission: "Permission Configuration",
                userNameHeader: "User name",
                accountHeader: "Account",
                roleHeader: "Role",
                createdAtHeader: "Created at",
                statusHeader: "Status",
                actionHeader: "Action",
                pendingStatus: "Pending",
                rejectedStatus: "Rejected",
                activeStatus: "Active",
                lockedStatus: "Locked",
                currentAccount: "Current account",
                adminText: "Admin",
                approveButton: "Approve account",
                rejectButton: "Reject",
                permissionsTitle: "Permissions",
                lockTitle: "Lock account",
                unlockTitle: "Unlock",
                promoteButton: "Promote",
                promoteTitle: "Promote to manager",
                demoteButton: "Demote",
                demoteTitle: "Demote to employee",
                noAccounts: "No accounts in the system yet.",
                backButton: "Back to list",
                permissionFor: "Permissions for:",
                cancelButton: "Cancel",
                savePermissionsButton: "Save Changes",
                enableToggleLabel: "Enable upload restriction for this account",
                permissionsSectionTitle: "Document types allowed for upload"
            }
        };

        const PERMISSIONS_BY_USER = JSON.parse(
            document.getElementById("permissionsDataJson").textContent || "{}"
        );
        let currentPermissionsUserId = null;

        function getPageLanguage() {
            const savedLanguage = localStorage.getItem("appLanguage");
            return (savedLanguage === "en" || savedLanguage === "vi") ? savedLanguage : "vi";
        }

        function applyPageTranslations() {
            const currentLanguage = getPageLanguage();
            const dict = PAGE_TRANSLATIONS[currentLanguage];
            if (!dict) return;

            document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-key");
                if (dict[key]) {
                    // Xử lý giữ lại icon bên trong button (nếu có)
                    if (element.querySelector('i')) {
                        const iconHtml = element.querySelector('i').outerHTML;
                        element.innerHTML = `${iconHtml} ${dict[key]}`;
                    } else {
                        element.textContent = dict[key];
                    }
                }
            });

            document.querySelectorAll("[data-i18n-title]").forEach(function (element) {
                const key = element.getAttribute("data-i18n-title");
                if (dict[key]) {
                    element.setAttribute("title", dict[key]);
                }
            });
        }

        // --- UX: Vô hiệu hóa checkbox khi tắt phân quyền ---
        window.togglePermissionsCheckboxes = function (mainToggle) {
            const checkboxes = document.querySelectorAll('.permission-checkbox');
            checkboxes.forEach(cb => {
                cb.disabled = !mainToggle.checked;
                // Nếu muốn giao diện mờ đi rõ ràng hơn khi tắt
                cb.closest('label').style.opacity = mainToggle.checked ? "1" : "0.6";
                cb.closest('label').style.pointerEvents = mainToggle.checked ? "auto" : "none";
            });
        };

        // --- HÀM ẨN/HIỆN (SỬ DỤNG .add / .remove ĐỂ TRÁNH LỖI) ---
        window.openPermissionsView = function (userId, fullName, username) {
            const mainView = document.getElementById("mainView");
            const permissionsView = document.getElementById("permissionsView");
            const pageTitleText = document.getElementById("pageTitleText");
            const toggleInput = document.getElementById("permissionsEnabledInput");

            // Gán thông tin động
            currentPermissionsUserId = userId;
            document.getElementById("targetUserRealName").textContent = fullName;
            document.getElementById("targetUsername").textContent = username;
            document.getElementById("permissionsForm").action = `/manager/users/${userId}/permissions`;

            // Nạp trạng thái phân quyền
            const currentPermissions = PERMISSIONS_BY_USER[userId] || { enabled: false, categories: [] };
            toggleInput.checked = currentPermissions.enabled;

            document.querySelectorAll('#permissionsCategoryList input[name="categories"]').forEach(function (checkbox) {
                checkbox.checked = currentPermissions.categories.includes(checkbox.value);
            });

            // Cập nhật trạng thái disable/enable của các nút ngay khi mở
            window.togglePermissionsCheckboxes(toggleInput);

            // Thay đổi tiêu đề
            const currentLang = getPageLanguage();
            if (pageTitleText) {
                pageTitleText.textContent = PAGE_TRANSLATIONS[currentLang].pageTitlePermission;
                pageTitleText.setAttribute("data-i18n-key", "pageTitlePermission");
            }

            // Ẩn bảng và hiện form (Cách an toàn 100%)
            mainView.classList.add("hidden");
            permissionsView.classList.remove("hidden");
        };

        window.closePermissionsView = function () {
            const mainView = document.getElementById("mainView");
            const permissionsView = document.getElementById("permissionsView");
            const pageTitleText = document.getElementById("pageTitleText");

            const currentLang = getPageLanguage();
            if (pageTitleText) {
                pageTitleText.textContent = PAGE_TRANSLATIONS[currentLang].pageTitleApproval;
                pageTitleText.setAttribute("data-i18n-key", "pageTitleApproval");
            }

            // Đảo ngược
            permissionsView.classList.add("hidden");
            mainView.classList.remove("hidden");
        };

        document.addEventListener("DOMContentLoaded", function () {
            applyPageTranslations();
            const languageButton = document.getElementById("languageToggle");
            if (languageButton) {
                languageButton.addEventListener("click", function () {
                    setTimeout(applyPageTranslations, 100);
                });
            }

            const permissionsForm = document.getElementById("permissionsForm");
            permissionsForm.addEventListener("submit", async function (event) {
                event.preventDefault();

                const formData = new FormData(permissionsForm);
                let response;
                try {
                    response = await fetch(permissionsForm.action, {
                        method: "POST",
                        body: formData,
                    });
                } catch (err) {
                    if (window.showToast) showToast("Không thể kết nối máy chủ.", "error");
                    return;
                }

                let payload = {};
                try {
                    payload = await response.json();
                } catch (err) {
                    // ignore, xử lý theo response.ok bên dưới
                }

                if (!response.ok) {
                    if (window.showToast) showToast(payload.error || "Lưu phân quyền thất bại.", "error");
                    return;
                }

                // Cập nhật cache cục bộ để lần mở panel kế tiếp phản ánh đúng
                if (currentPermissionsUserId !== null) {
                    PERMISSIONS_BY_USER[currentPermissionsUserId] = {
                        enabled: formData.get("enabled") === "1",
                        categories: formData.getAll("categories"),
                    };
                }

                if (window.showToast) showToast(payload.message || "Đã lưu phân quyền.", "success");
                window.closePermissionsView();
            });
        });
    })();
    let pendingFormId = null;

    window.openConfirmModal = function (formId, title, message) {
        pendingFormId = formId;

        // Set nội dung
        document.getElementById('confirmModalTitle').innerText = title;
        document.getElementById('confirmModalMessage').innerText = message;

        // Hiển thị modal với animation
        const modal = document.getElementById('customConfirmModal');
        const modalContent = document.getElementById('customConfirmModalContent');

        modal.classList.remove('hidden');
        // Trễ 1 chút để browser kịp render display:block trước khi apply opacity
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modalContent.classList.remove('scale-95');
        }, 10);
    };

    window.closeConfirmModal = function () {
        pendingFormId = null;
        const modal = document.getElementById('customConfirmModal');
        const modalContent = document.getElementById('customConfirmModalContent');

        // Chạy animation ẩn
        modal.classList.add('opacity-0');
        modalContent.classList.add('scale-95');

        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200); // Đợi animation css chạy xong (duration-200)
    };

    // Lắng nghe sự kiện click nút Xác nhận trong Modal
    document.getElementById('confirmModalBtn').addEventListener('click', function () {
        if (pendingFormId) {
            const form = document.getElementById(pendingFormId);
            if (form) {
                form.submit();
            }
        }
        closeConfirmModal();
    });
</script>

<style>
    .fade-in {
        animation: fadeIn 0.2s ease-out forwards;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
{% endblock %}
</file>

