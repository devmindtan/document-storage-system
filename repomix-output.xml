<file path="templates/manager_pending.html">
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Hồ sơ chờ duyệt</title>
    <link rel="stylesheet" href="/static/style.css?v=5001">

    <style>
        .pending-new-badge {
            display: inline-block;
            margin-top: 6px;
            padding: 4px 8px;
            border-radius: 999px;
            background: #fff3cd;
            color: #7a5200;
            font-size: 12px;
            font-weight: bold;
            white-space: nowrap;
        }
