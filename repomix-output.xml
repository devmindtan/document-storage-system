            </div>
            <div class="pt-1">
                <div class="flex items-center gap-3">
                    <h2 class="text-xl font-bold text-slate-800 tracking-tight" data-i18n-key="createManagerHeader">Cấp
                        quyền Quản lý hệ thống</h2>
