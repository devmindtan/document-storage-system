            >

            <label for="full_name">Họ và tên</label>
            <input
                id="full_name"
                type="text"
                name="full_name"
                placeholder="Nhập họ và tên"
                required
            >

            <label for="password">Mật khẩu</label>
            <input
                id="password"
                type="password"
                name="password"
                placeholder="Ít nhất 8 ký tự"
                required
