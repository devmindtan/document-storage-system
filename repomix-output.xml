/* ============================================================
   GLOBAL SETTINGS
   ============================================================ */

:root {
    --primary: #174a7c;
    --primary-dark: #0f355c;
    --danger: #b33131;
    --danger-dark: #922727;
    --success: #18743a;
    --success-dark: #175b2d;
    --border: #d7dce2;
    --page-bg: #f2f5f8;
    --soft-bg: #f3f7fb;

    /* Chỉnh chiều ngang trang Kho hồ sơ đã duyệt tại đây */
    --approved-box-width: 1320px;
}

* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: var(--page-bg);
    margin: 0;
    padding: 0;
}

body.app-page {
    padding-top: 100px;
}

h1 {
    text-align: center;
    font-size: 22px;
    color: #1f4e79;
}

label {
    display: block;
    margin-top: 15px;
    margin-bottom: 6px;
    font-weight: bold;
}

input,
select {
    width: 100%;
    padding: 10px;
    border: 1px solid #cccccc;
    border-radius: 5px;
    background: white;
    font-size: 15px;
}

button {
    width: 100%;
    margin-top: 22px;
    padding: 11px;
    background: #1f4e79;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background: #163b5c;
}

hr {
    border: none;
    border-top: 1px solid #aaaaaa;
    margin: 24px 0;
}

/* ============================================================
   HEADER / LOGO / LANGUAGE
   ============================================================ */

.logo-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;

    height: 82px;
    background-color: white;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 32px;
    box-sizing: border-box;

    z-index: 9998;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);
}

.logo-header .corner-logo-link {
    position: static !important;
    top: auto !important;
    left: auto !important;

    margin: 0 !important;
    padding: 0 !important;

    display: inline-flex !important;
    align-items: center !important;
    text-decoration: none !important;
}

.logo-header .corner-logo {
    width: 200px !important;
    max-width: 250px !important;
    height: auto !important;
    object-fit: contain !important;
    display: block !important;
}

.language-toggle,
.logo-header .language-toggle {
    width: auto !important;
    min-width: 54px !important;
    max-width: 64px !important;
    height: 34px !important;

    padding: 0 14px !important;
    margin: 0 !important;

    border: none !important;
    border-radius: 17px !important;

    background-color: var(--primary) !important;
    color: white !important;

    font-size: 14px !important;
    font-weight: bold !important;
    line-height: 34px !important;
    text-align: center !important;

    cursor: pointer !important;
    flex: 0 0 auto !important;
}

.language-toggle:hover,
.logo-header .language-toggle:hover {
    background-color: var(--primary-dark) !important;
}

/* ============================================================
   LOGIN
   ============================================================ */

body.login-page {
    min-height: 100vh !important;
    margin: 0 !important;

    background-image:
        linear-gradient(rgba(240, 244, 248, 0.25), rgba(240, 244, 248, 0.25)),
        url("/static/images/login_background.jpg?v=1") !important;

    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;
    background-attachment: fixed !important;
}

.login-box {
    width: 380px;
    margin: 170px auto;
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

.subtitle,
.login-subtitle {
    text-align: center;
    color: #666666;
}

.register-link {
    margin-top: 18px;
    text-align: center;
    font-size: 14px;
}

.register-link a,
.small-link {
    color: var(--primary);
    font-weight: bold;
    text-decoration: none;
}

.register-link a:hover,
.small-link:hover {
    text-decoration: underline;
}

.login-clock {
    position: fixed;
    right: 24px;
    bottom: 18px;

    background-color: rgba(255, 255, 255, 0.85);
    color: var(--primary);

    padding: 8px 14px;
    border-radius: 8px;

    font-size: 18px;
    font-weight: bold;

    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    z-index: 9999;
}

/* ============================================================
   MESSAGES
   ============================================================ */

.error-message,
.success-message {
    padding: 10px 12px;
    border-radius: 6px;
    margin-top: 15px;
    margin-bottom: 16px;
    font-weight: bold;
    white-space: pre-line !important;
}

.error-message {
    background: #ffe4e4;
    color: #b00020;
}

.success-message {
    background-color: #e6f4ea;
    color: var(--success);
}

.empty-message {
    padding: 18px;
    background: #f3f6f8;
    border-radius: 6px;
}

/* ============================================================
   DASHBOARD / MENU
   ============================================================ */

.dashboard-box {
    max-width: 900px;
    margin: 60px auto;
    background: white;
    padding: 35px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
}

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
}

.top-bar h1 {
    text-align: left;
    margin-bottom: 5px;
}

.logout-button {
    background: #a83232;
    color: white;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 5px;
    font-weight: bold;
}

.top-action-buttons {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 14px !important;
}

.admin-back-button {
    height: 38px !important;
    min-height: 38px !important;

    padding: 0 15px !important;
    margin: 0 !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 6px !important;

    background-color: var(--primary) !important;
    color: white !important;

    font-size: 15px !important;
    font-weight: bold !important;
    line-height: 1 !important;
    text-align: center !important;
    text-decoration: none !important;
}

.admin-back-button:hover {
    background-color: var(--primary-dark) !important;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 20px;
}

.menu-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    background: #fafcff;
}

.menu-card h3 {
    color: #1f4e79;
    margin-top: 0;
}

.menu-link {
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
}

.menu-link:hover {
    border-color: #1f4e79;
    transform: translateY(-2px);
}

/* ============================================================
   FORMS / SEARCH
   ============================================================ */

.info-box {
    background-color: #f5f7fb;
    border: 1px solid #d9e1ec;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 16px;
}

.checkbox-row {
    margin: 12px 0;
    font-size: 16px;
}

.checkbox-row input {
    width: auto;
    margin-right: 8px;
}

.advanced-search-form {
    display: grid;
    grid-template-columns: repeat(3, minmax(180px, 1fr));
    gap: 16px;
    align-items: end;
}

.search-form {
    width: 100%;
}

.search-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.search-field label {
    font-weight: bold;
}

.search-field input,
.search-field select {
    padding: 10px 12px;
    border: 1px solid #cfd7e2;
    border-radius: 6px;
    font-size: 15px;
}

.search-buttons {
    display: flex;
    gap: 10px;
    align-items: center;
}

.search-button,
.reset-button {
    padding: 10px 16px;
    border-radius: 6px;
    text-decoration: none;
    border: none;
    font-size: 15px;
    cursor: pointer;
}

.search-button {
    background-color: var(--primary);
    color: white;
}

.reset-button {
    background-color: #e9eef5;
    color: var(--primary);
    font-weight: bold;
}

/* ============================================================
   TABLES
   ============================================================ */

.document-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.document-table th,
.document-table td {
    border: 1px solid var(--border);
    padding: 10px;
    text-align: left;
    vertical-align: top;
}

.document-table th {
    background: #1f4e79;
    color: white;
}

.status-active {
    color: var(--success);
    font-weight: bold;
}

.status-locked {
    color: #a83232;
    font-weight: bold;
}

.status-pending {
    color: #b26a00;
    font-weight: bold;
}

.self-account {
    color: #666666;
    font-style: italic;
    font-size: 14px;
}

/* ============================================================
   COMMON BUTTONS
   ============================================================ */

.download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    background-color: var(--primary);
    color: white;

    padding: 9px 14px;
    border-radius: 6px;

    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
    white-space: nowrap;
}

