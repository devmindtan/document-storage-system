                    unknownStatus: "Không xác định",
                    noManagerDocuments: "Bạn chưa upload hồ sơ nào."
                },
                en: {
                    myDocumentsTitle: "MY DOCUMENT",
                    managerLabel: "Manager:",
                    backButton: "Back",
                    idHeader: "ID",
                    fileNameHeader: "File name",
                    projectHeader: "Project",
                    typeHeader: "Type",
                    submittedAtHeader: "Submitted at",
                    statusHeader: "Status",
                    approvedByHeader: "Approved by",
                    rejectionReasonHeader: "Rejection reason",
                    pendingStatus: "Pending manager approval",
                    approvedStatus: "Approved",
                    rejectedStatus: "Rejected",
                    unknownStatus: "Unknown",
                    noManagerDocuments: "You have not uploaded any documents yet."
                }
            };

            function getPageLanguage() {
                const savedLanguage = localStorage.getItem("appLanguage");

                if (savedLanguage === "en" || savedLanguage === "vi") {
                    return savedLanguage;
                }

                return "vi";
            }

            function applyPageTranslations() {
                const currentLanguage = getPageLanguage();

                document.querySelectorAll("[data-i18n-key]").forEach(function (element) {
                    const key = element.getAttribute("data-i18n-key");

                    if (
                        PAGE_TRANSLATIONS[currentLanguage] &&
                        PAGE_TRANSLATIONS[currentLanguage][key]
                    ) {
                        element.textContent = PAGE_TRANSLATIONS[currentLanguage][key];
                    }
                });
            }

            document.addEventListener("DOMContentLoaded", function () {
                setTimeout(applyPageTranslations, 50);

                const languageButton = document.getElementById("languageToggle");

                if (languageButton) {
                    languageButton.addEventListener("click", function () {
                        setTimeout(applyPageTranslations, 100);
                    });
                }
            });

            window.addEventListener("load", function () {
                setTimeout(applyPageTranslations, 50);
            });
        })();
    </script>
</body>
</html>
