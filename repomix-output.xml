            <select id="delete_category_id" name="delete_category_id" required>
                <option value="">
                    Vui lòng chọn project để xem file con
                </option>
            </select>

            <input
                id="delete_category_project_key"
                type="hidden"
                name="project_key"
                value=""
            >

            <button type="submit" class="danger-button" id="deleteCategoryButton" disabled>
                Xóa file con
            </button>
        </form>
    </div>

    <p class="note-text">
        Nếu cần project mới hoặc file con mới, hãy chọn trực tiếp trong danh sách phía trên. Hồ sơ do quản lý upload sẽ được đưa thẳng vào kho chính thức.
    </p>
</div>



<script>
function getCurrentConfirmLanguage() {
    const currentLanguage = localStorage.getItem("appLanguage");

    if (currentLanguage === "en") {
        return "en";
    }

    return "vi";
}

function getDeleteProjectConfirmText() {
    const language = getCurrentConfirmLanguage();

    if (language === "en") {
        return "Are you sure you want to delete this project? All documents under this project will also be deleted.";
    }

    return "Bạn có chắc muốn xóa project này không? Tất cả hồ sơ trong project này cũng sẽ bị xóa.";
}

function getDeleteCategoryConfirmText() {
    const language = getCurrentConfirmLanguage();

    if (language === "en") {
        return "Are you sure you want to delete this document type? It will be hidden from new uploads.";
    }

    return "Bạn có chắc muốn xóa file con này không? File con này sẽ bị ẩn khỏi danh sách upload mới.";
}

function handleDeleteProjectSubmit() {
    const deleteProjectForm = document.getElementById("deleteProjectForm");
    const deleteProjectSelect = document.getElementById("delete_project_id");

    if (!deleteProjectForm || !deleteProjectSelect || !deleteProjectSelect.value) {
        return false;
    }

    deleteProjectForm.action = "/projects/" + deleteProjectSelect.value + "/delete";

    return confirm(getDeleteProjectConfirmText());
}

function handleDeleteCategorySubmit() {
    const deleteCategoryForm = document.getElementById("deleteCategoryForm");
    const deleteCategorySelect = document.getElementById("delete_category_id");

    if (!deleteCategoryForm || !deleteCategorySelect || !deleteCategorySelect.value) {
        return false;
    }

    deleteCategoryForm.action = "/manager/project-categories/" + deleteCategorySelect.value + "/delete";

    return confirm(getDeleteCategoryConfirmText());
}
</script>


